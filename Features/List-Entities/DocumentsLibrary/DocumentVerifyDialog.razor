@namespace MITANZ360Pro.Web.Modules.Entities.DocumentsLibrary
@using MITANZ360Pro.Web.Modules.Entities.DocumentsLibrary
@inject IDocumentLibraryService DocumentService
@inject NotificationService NotificationService
@inject DialogService DialogService

<div class="ms-docs">
    <p>Confirm verification of this document.</p>
    <div class="form-row">
        <label>Remarks (optional)</label>
        <RadzenTextArea @bind-Value="Remarks" Style="width:100%" Rows="3" />
    </div>
    <div style="display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@(() => DialogService.Close(false))" />
        <RadzenButton Text="Verify" Icon="verified" ButtonStyle="ButtonStyle.Success" Click="@VerifyAsync" Disabled="@IsBusy" />
    </div>
</div>

@code {
    [Parameter] public string DriveItemId { get; set; } = "";
    [Parameter] public string VerifiedBy { get; set; } = "";

    private string? Remarks;
    private bool IsBusy;

    private async Task VerifyAsync()
    {
        IsBusy = true;
        try
        {
            var result = await DocumentService.VerifyDocumentAsync(DriveItemId, VerifiedBy, Remarks);
            if (result.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Verified", "Document verified.");
                DialogService.Close(true);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Verify failed", result.ErrorMessage ?? "Unknown error");
            }
        }
        finally
        {
            IsBusy = false;
        }
    }
}
