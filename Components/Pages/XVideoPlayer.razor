@using Radzen

@if (IsOpen)
{
    <div class="evp-overlay">

        <div class="evp-container">

            <!-- HEADER -->
            <div class="evp-header">

                <div class="evp-title">
                    🎬 Video Learning Module
                </div>

                <button class="evp-close" @onclick="Close">✖</button>

            </div>

            <!-- TABS -->
            <RadzenTabs>

                <!-- VIDEO TAB -->
                <RadzenTabsItem Text="Video">
                    <div class="evp-tab-content">

                        <video class="evp-video" controls autoplay>
                            <source src="@VideoUrl" type="video/mp4" />
                        </video>

                    </div>
                </RadzenTabsItem>

                <!-- ENGAGEMENT -->
                <RadzenTabsItem Text="Engagement">
                    <div class="evp-tab-content">
                        <h4>Engagement</h4>
                        <p>Track user interaction, quiz, feedback, and AI insights.</p>
                    </div>
                </RadzenTabsItem>

                <!-- INSTRUCTIONS -->
                <RadzenTabsItem Text="Instructions">
                    <div class="evp-tab-content">
                        <h4>Instructions</h4>
                        <p>Follow the learning steps and complete activities.</p>
                    </div>
                </RadzenTabsItem>

                <!-- GENERAL -->
                <RadzenTabsItem Text="General">
                    <div class="evp-tab-content">
                        <h4>General Info</h4>
                        <p>Course details, metadata, and overview.</p>
                    </div>
                </RadzenTabsItem>

            </RadzenTabs>

        </div>

    </div>
}

<style>

    /* ================= OVERLAY ================= */
    .evp-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    /* ================= MAIN CONTAINER ================= */
    .evp-container {
        width: 95%;
        height: 92%;
        background: #ffffff;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    /* ================= HEADER ================= */
    .evp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
    }

    /* TITLE */
    .evp-title {
        font-weight: 600;
    }

    /* CLOSE */
    .evp-close {
        background: #ffffff;
        border: 1px solid #ddd;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        cursor: pointer;
    }

    /* ================= TAB CONTENT ================= */
    .evp-tab-content {
        padding: 12px;
        height: calc(100vh - 180px);
        overflow-y: auto;
    }

    /* ================= VIDEO ================= */
    .evp-video {
        width: 100%;
        height: 100%;
        max-height: 70vh;
        border-radius: 12px;
        background: #000;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 768px) {

        .evp-container {
            width: 100%;
            height: 100%;
            border-radius: 0;
        }

        .evp-video {
            max-height: 50vh;
        }
    }

</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string VideoUrl { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}