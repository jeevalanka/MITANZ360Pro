@page "/sms-system"
@layout MainLayout_No_Left_RightPan

<PageTitle>AI-Powered Student Management System</PageTitle>

<div style="
    min-height:100vh;
    background:
    radial-gradient(circle at top right, rgba(37,99,235,.12), transparent 30%),
    radial-gradient(circle at bottom left, rgba(124,58,237,.08), transparent 35%),
    linear-gradient(to bottom,#ffffff,#f8fafc);
    padding:30px;">

    <!-- Header -->

    <div style="
        max-width:1600px;
        margin:auto;
        text-align:center;
        margin-bottom:40px;">

        <div style="
            display:inline-block;
            padding:12px 24px;
            border-radius:999px;
            background:#eef6ff;
            border:1px solid #dbeafe;
            color:#2563eb;
            font-weight:700;
            margin-bottom:20px;">

            🚀 Next Generation AI Student Management System
        </div>

        <h1 style="
            font-size:4rem;
            font-weight:900;
            line-height:1.1;
            color:#0f172a;
            margin-bottom:15px;">

            MITANZ360Pro

            <span style="
                display:block;
                background:linear-gradient(90deg,#2563eb,#7c3aed);
                -webkit-background-clip:text;
                -webkit-text-fill-color:transparent;">

                AI-Powered Student Management System
            </span>

        </h1>

        <p style="
            max-width:1000px;
            margin:auto;
            color:#64748b;
            font-size:1.15rem;
            line-height:1.9;">

            A comprehensive AI-driven Student Management System designed to manage
            the complete student lifecycle from enquiry to alumni engagement.
            Built to improve learner success, automate administrative processes,
            provide intelligent insights, and support educational excellence
            through advanced Artificial Intelligence and automation.
        </p>

    </div>

    <!-- Main Image -->

    <div style="
        max-width:1800px;
        margin:auto;
        background:white;
        border-radius:40px;
        padding:15px;
        border:1px solid #e2e8f0;
        box-shadow:
        0 10px 40px rgba(0,0,0,.05),
        0 25px 80px rgba(0,0,0,.08);">

        <img src="/Images/SMS System.png"
             alt="MITANZ360Pro AI Student Management System"
             style="
        width:100%;
        height:auto;
        display:block;
        border-radius:30px;" />

    </div>

    <!-- Key Benefits -->

    <div style="
        max-width:1600px;
        margin:50px auto 0 auto;">

        <div style="
            text-align:center;
            margin-bottom:40px;">

            <h2 style="
                font-size:2.8rem;
                font-weight:800;
                color:#0f172a;">

                Why Choose MITANZ360Pro SMS?
            </h2>

            <p style="
                color:#64748b;
                font-size:1.1rem;">

                Student Success. Academic Excellence. AI Automation.
            </p>

        </div>

        <div style="
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
            gap:25px;">

            <div style="
                background:white;
                border-radius:30px;
                padding:30px;
                border:1px solid #e5e7eb;
                box-shadow:0 8px 25px rgba(0,0,0,.05);">

                <h3>🤖 AI Student Assistant</h3>

                <p>
                    24/7 intelligent student support for enrolment, course
                    information, assessments, attendance, results,
                    documentation and academic guidance.
                </p>

            </div>

            <div style="
                background:white;
                border-radius:30px;
                padding:30px;
                border:1px solid #e5e7eb;
                box-shadow:0 8px 25px rgba(0,0,0,.05);">

                <h3>📈 Predictive Analytics</h3>

                <p>
                    AI analyses attendance, engagement, assessments and
                    academic performance to identify at-risk learners and
                    improve retention.
                </p>

            </div>

            <div style="
                background:white;
                border-radius:30px;
                padding:30px;
                border:1px solid #e5e7eb;
                box-shadow:0 8px 25px rgba(0,0,0,.05);">

                <h3>⚡ Smart Automation</h3>

                <p>
                    Automates admissions, communications, attendance tracking,
                    reminders, approvals, certificates and compliance workflows.
                </p>

            </div>

        </div>

    </div>

    <!-- Core Modules -->

    <div style="
        max-width:1600px;
        margin:60px auto;">

        <h2 style="
            text-align:center;
            font-size:2.5rem;
            margin-bottom:40px;">

            Core Functional Modules
        </h2>

        <div style="
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
            gap:20px;">

            <div style="background:white;border-radius:25px;padding:25px;">👨‍🎓 Student Profile Management</div>
            <div style="background:white;border-radius:25px;padding:25px;">📝 Admissions & Enrolment</div>
            <div style="background:white;border-radius:25px;padding:25px;">📚 Course Management</div>
            <div style="background:white;border-radius:25px;padding:25px;">📅 Timetable & Scheduling</div>
            <div style="background:white;border-radius:25px;padding:25px;">✅ Attendance Management</div>
            <div style="background:white;border-radius:25px;padding:25px;">🧪 Assessments & Exams</div>
            <div style="background:white;border-radius:25px;padding:25px;">📊 Academic Progress Tracking</div>
            <div style="background:white;border-radius:25px;padding:25px;">💰 Finance & Billing</div>
            <div style="background:white;border-radius:25px;padding:25px;">📄 Documents & Certificates</div>
            <div style="background:white;border-radius:25px;padding:25px;">🎓 Alumni Management</div>
            <div style="background:white;border-radius:25px;padding:25px;">📈 Reporting & Analytics</div>
            <div style="background:white;border-radius:25px;padding:25px;">⚙️ Administration & Configuration</div>

        </div>

    </div>

    <!-- AI Capabilities -->

    <div style="
        max-width:1600px;
        margin:auto;">

        <div style="
            background:linear-gradient(135deg,#2563eb,#7c3aed);
            color:white;
            padding:60px;
            border-radius:40px;">

            <h2 style="
                font-size:3rem;
                margin-bottom:25px;">

                AI Core Capabilities
            </h2>

            <div style="
                display:grid;
                grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
                gap:25px;">

                <div>🤖 AI Student Assistant</div>
                <div>🎯 AI Enrolment Advisor</div>
                <div>🚨 AI Risk Predictor</div>
                <div>📚 AI Academic Coach</div>
                <div>📅 AI Attendance Intelligence</div>
                <div>📨 AI Communication Hub</div>
                <div>📄 AI Document Analyzer</div>
                <div>📊 AI Insights & Analytics</div>
                <div>🏆 AI Student Success Agent</div>
                <div>⚡ AI Workflow Automation</div>

            </div>

        </div>

    </div>

    <!-- Student Lifecycle -->

    <div style="
        max-width:1600px;
        margin:60px auto;
        text-align:center;">

        <h2 style="
            font-size:2.5rem;
            margin-bottom:40px;">

            Complete Student Lifecycle Management
        </h2>

        <div style="
            display:flex;
            flex-wrap:wrap;
            justify-content:center;
            gap:15px;">

            <div style="padding:20px 30px;background:white;border-radius:20px;">🔍 Enquiry</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">📝 Apply</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">🎓 Enrol</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">📚 Learn</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">📊 Monitor</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">🏆 Achieve</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">🎓 Graduate</div>
            <div style="padding:20px 30px;background:white;border-radius:20px;">🤝 Alumni</div>

        </div>

    </div>

    <!-- Footer -->

    <div style="
        max-width:1600px;
        margin:60px auto 20px auto;
        text-align:center;">

        <h2 style="
            font-size:2.8rem;
            font-weight:900;
            margin-bottom:15px;">

            Empowering Education Through AI
        </h2>

        <p style="
            color:#64748b;
            max-width:900px;
            margin:auto;">

            MITANZ360Pro SMS combines Student Management, Academic Intelligence,
            Predictive Analytics, AI Automation and Student Success Management
            into one integrated education platform aligned with the MITANZ360Pro
            Enterprise AI Education Framework. :contentReference[oaicite:0]{index=0}
        </p>

    </div>

</div>