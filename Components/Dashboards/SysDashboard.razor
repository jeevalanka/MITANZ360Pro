    // ---- UI helpers ----
    string BadgeStyle(int score)
    {
        if (score >= 97) return "background: rgba(34,197,94,.12); color: var(--green); border:1px solid rgba(34,197,94,.25);";
        if (score >= 93) return "background: rgba(245,158,11,.12); color: var(--amber); border:1px solid rgba(245,158,11,.25);";
        return "background: rgba(239,68,68,.12); color: var(--red); border:1px solid rgba(239,68,68,.25);";
    }

    string SeverityBadge(string s) => s switch
    {
        "Critical" => "background: rgba(239,68,68,.12); color: var(--red); border:1px solid rgba(239,68,68,.30);",
        "Warning"  => "background: rgba(245,158,11,.12); color: var(--amber); border:1px solid rgba(245,158,11,.30);",
        _          => "background: rgba(34,211,238,.12); color: var(--cyan); border:1px solid rgba(34,211,238,.30);",
    };

    string ServiceBadge(string state) => state switch
    {
        "Healthy"  => "background: rgba(34,197,94,.12); color: var(--green); border:1px solid rgba(34,197,94,.25);",
        "Degraded" => "background: rgba(245,158,11,.12); color: var(--amber); border:1px solid rgba(245,158,11,.25);",
        _          => "background: rgba(239,68,68,.12); color: var(--red); border:1px solid rgba(239,68,68,.25);",
    };

    string DbHealthBadge(string state) => state switch
    {
        "OK"       => "background: rgba(34,197,94,.12); color: var(--green); border:1px solid rgba(34,197,94,.25);",
        "Degraded" => "background: rgba(245,158,11,.12); color: var(--amber); border:1px solid rgba(245,158,11,.25);",
        _          => "background: rgba(239,68,68,.12); color: var(--red); border:1px solid rgba(239,68,68,.25);",
    };

    string JobBadge(string status) => status switch
    {
        "Running"   => "background: rgba(37,99,235,.14); color: var(--blue); border:1px solid rgba(37,99,235,.35);",
        "Queued"    => "background: rgba(139,92,246,.14); color: var(--violet); border:1px solid rgba(139,92,246,.35);",
        "Completed" => "background: rgba(34,197,94,.12); color: var(--green); border:1px solid rgba(34,197,94,.25);",
        "Failed"    => "background: rgba(239,68,68,.12); color: var(--red); border:1px solid rgba(239,68,68,.25);",
        _           => "background: rgba(148,163,184,.10); color: var(--muted); border:1px solid rgba(148,163,184,.25);",
    };

    string SmallBadge(int val, int warn, int crit, bool isMs = false)
    {
        // warn/crit thresholds
        if (val >= crit) return "background: rgba(239,68,68,.12); color: var(--red); border:1px solid rgba(239,68,68,.25);";
        if (val >= warn) return "background: rgba(245,158,11,.12); color: var(--amber); border:1px solid rgba(245,158,11,.25);";
        return "background: rgba(34,197,94,.12); color: var(--green); border:1px solid rgba(34,197,94,.25);";
    }

    // ---- Models ----
    class MetricPoint
    {
        public MetricPoint(string timeLabel, int value) { TimeLabel = timeLabel; Value = value; }
        public string TimeLabel { get; set; } = "";
        public int Value { get; set; }
    }

    class PieSlice
    {
        public PieSlice(string name, int value) { Name = name; Value = value; }
        public string Name { get; set; } = "";
        public int Value { get; set; }
    }

    class SecurityAlert
    {
        public DateTime Time { get; set; }
        public string Severity { get; set; } = "Info";
        public string Category { get; set; } = "";
        public string User { get; set; } = "";
        public string Message { get; set; } = "";
        public string SourceIp { get; set; } = "";
    }

    class ServiceStatus
    {
        public ServiceStatus(string name, string icon, string state, string detail, string state2, string color)
        { Name = name; Icon = icon; State = state2; Detail = detail; Color = color; }
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "info";
        public string State { get; set; } = "Healthy";
        public string Detail { get; set; } = "";
        public string Color { get; set; } = "#22C55E";
    }

    class JobItem
    {
        public JobItem(string name, string status, string runtime) { Name = name; Status = status; Runtime = runtime; }
        public string Name { get; set; } = "";
        public string Status { get; set; } = "";
        public string Runtime { get; set; } = "";
    }
