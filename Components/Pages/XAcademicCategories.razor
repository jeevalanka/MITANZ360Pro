@page "/icon-categories"
@layout MainLayout

<PageTitle>MITANZ360Pro - Academic Categories</PageTitle>

<div class="academic-page">

    <!-- HERO SECTION -->
    <div class="hero-section text-center">

        <div class="hero-badge">
            🌐 Enterprise Ecosystem
        </div>

        <h1 class="hero-title">
            Smart Academic & Enterprise Platform
        </h1>

        <p class="hero-subtitle">
            Modern education, AI, finance, student services,
            certifications, HRM, and technology ecosystem
            designed with enterprise-grade Microsoft-style architecture.
        </p>

    </div>

    <!-- CATEGORY GRID -->
    <div class="category-grid">

        <!-- EDUCATION -->
        <div class="glass-card education-card">

            <div>
                <div class="icon-area">🎓</div>

                <h3>Education</h3>

                <p>
                    Modern learning management systems,
                    digital classrooms, online delivery,
                    and academic progression tracking.
                </p>
            </div>

            <div class="tag-container">
                <span>📘 LMS</span>
                <span>📝 Exams</span>
                <span>📅 Timetable</span>
                <span>🏆 Awards</span>
            </div>

        </div>

        <!-- TECHNOLOGY -->
        <div class="glass-card technology-card">

            <div>
                <div class="icon-area">💻</div>

                <h3>Technology</h3>

                <p>
                    Cloud computing, Microsoft ecosystem,
                    enterprise development, AI integration,
                    and automation technologies.
                </p>
            </div>

            <div class="tag-container">
                <span>☁️ Azure</span>
                <span>⚡ Power Platform</span>
                <span>🧠 AI</span>
                <span>🔐 Security</span>
            </div>

        </div>

        <!-- FINANCE -->
        <div class="glass-card finance-card">

            <div>
                <div class="icon-area">💰</div>

                <h3>Finance</h3>

                <p>
                    Student billing, smart invoicing,
                    finance tracking, accounting workflows,
                    and revenue management.
                </p>
            </div>

            <div class="tag-container">
                <span>💳 Payments</span>
                <span>📈 Reports</span>
                <span>🧾 Billing</span>
                <span>🏦 Accounts</span>
            </div>

        </div>

        <!-- HRM -->
        <div class="glass-card hr-card">

            <div>
                <div class="icon-area">👨‍💼</div>

                <h3>HRM</h3>

                <p>
                    Staff lifecycle management,
                    tutor assignment, scheduling systems,
                    payroll workflows, and administration.
                </p>
            </div>

            <div class="tag-container">
                <span>👥 Staff</span>
                <span>📋 Payroll</span>
                <span>🕒 Scheduling</span>
                <span>🧑‍🏫 Tutors</span>
            </div>

        </div>

        <!-- SUPPORT -->
        <div class="glass-card support-card">

            <div>
                <div class="icon-area">🎧</div>

                <h3>Help & Support</h3>

                <p>
                    AI-powered support desk,
                    ticketing systems, academic assistance,
                    and enterprise service workflows.
                </p>
            </div>

            <div class="tag-container">
                <span>🎫 Helpdesk</span>
                <span>📞 Support</span>
                <span>🤖 AI Assist</span>
                <span>⚙️ Services</span>
            </div>

        </div>

        <!-- STUDENT -->
        <div class="glass-card student-card">

            <div>
                <div class="icon-area">👨‍🎓</div>

                <h3>Student Services</h3>

                <p>
                    Enrollment systems, onboarding,
                    academic records, counseling,
                    student engagement, and lifecycle services.
                </p>
            </div>

            <div class="tag-container">
                <span>✅ Enrollment</span>
                <span>📂 Records</span>
                <span>🎒 Students</span>
                <span>📘 Guidance</span>
            </div>

        </div>

        <!-- CERTIFICATION -->
        <div class="glass-card certificate-card">

            <div>
                <div class="icon-area">🏅</div>

                <h3>Certification</h3>

                <p>
                    International certifications,
                    Microsoft exams, compliance management,
                    assessment validation, and achievements.
                </p>
            </div>

            <div class="tag-container">
                <span>📜 Certificates</span>
                <span>🧪 Assessments</span>
                <span>🔍 Compliance</span>
                <span>🏆 Success</span>
            </div>

        </div>

        <!-- SKILLS -->
        <div class="glass-card skill-card">

            <div>
                <div class="icon-area">🚀</div>

                <h3>Skills Development</h3>

                <p>
                    Industry-ready practical skills,
                    cloud engineering, automation,
                    AI learning, and digital transformation.
                </p>
            </div>

            <div class="tag-container">
                <span>🛠️ Labs</span>
                <span>🌍 Networking</span>
                <span>⚙️ Automation</span>
                <span>📊 Analytics</span>
            </div>

        </div>

        <!-- AI -->
        <div class="glass-card ai-card">

            <div>
                <div class="icon-area">🧠</div>

                <h3>AI Engine</h3>

                <p>
                    Enterprise AI orchestration,
                    predictive analytics, smart recommendations,
                    and intelligent automation services.
                </p>
            </div>

            <div class="tag-container">
                <span>🤖 AI</span>
                <span>📡 Insights</span>
                <span>🔄 Automation</span>
                <span>🚀 Innovation</span>
            </div>

        </div>

        <!-- DIGITAL LIBRARY -->
        <div class="glass-card library-card">

            <div>
                <div class="icon-area">📚</div>

                <h3>Digital Library</h3>

                <p>
                    Centralized academic resources,
                    eBooks, videos, learning materials,
                    and knowledge repositories.
                </p>
            </div>

            <div class="tag-container">
                <span>📖 eBooks</span>
                <span>🎥 Videos</span>
                <span>🗂️ Resources</span>
                <span>🌐 Online</span>
            </div>

        </div>

        <!-- ANALYTICS -->
        <div class="glass-card analytics-card">

            <div>
                <div class="icon-area">📊</div>

                <h3>Analytics</h3>

                <p>
                    Enterprise reporting, student insights,
                    academic dashboards, KPI monitoring,
                    and business intelligence.
                </p>
            </div>

            <div class="tag-container">
                <span>📈 Reports</span>
                <span>📉 Metrics</span>
                <span>📡 Monitoring</span>
                <span>🧮 BI</span>
            </div>

        </div>

        <!-- COLLABORATION -->
        <div class="glass-card collaboration-card">

            <div>
                <div class="icon-area">🌐</div>

                <h3>Collaboration</h3>

                <p>
                    Online collaboration,
                    Microsoft Teams integration,
                    communication systems,
                    and enterprise connectivity.
                </p>
            </div>

            <div class="tag-container">
                <span>👥 Teams</span>
                <span>💬 Chat</span>
                <span>📡 Connect</span>
                <span>🌎 Global</span>
            </div>

        </div>

    </div>

</div>

<style>

    body {
        overflow-x: hidden;
    }

    .academic-page {
        min-height: 100vh;
        padding: 25px 16px 60px;
        background: #ffffff;
        overflow-x: hidden;
    }

    /* HERO SECTION */

    .hero-section {
        max-width: 1100px;
        margin: auto;
        margin-bottom: 35px;
        padding-top: 10px;
    }

    .hero-badge {
        display: inline-block;
        padding: 10px 22px;
        border-radius: 999px;
        background: linear-gradient( 135deg, #4f46e5, #2563eb );
        color: white;
        font-weight: 600;
        margin-bottom: 10px;
        box-shadow: 0 10px 25px rgba(79,70,229,0.20);
    }

    .hero-title {
        font-size: clamp(1.5rem, 3vw, 3.0rem);
        font-weight: 800;
        color: darkorange;
        line-height: 1.1;
        margin-bottom: 10px;
    }

    .hero-subtitle {
        font-size: 1rem;
        color: #4b5563;
        line-height: 1.8;
        max-width: 900px;
        margin: auto;
    }

    /* GRID */

    .category-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        width: 100%;
        max-width: 1450px;
        margin: auto;
        align-items: stretch;
    }

    /* CARDS */

    .glass-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        padding: 28px;
        border-radius: 28px;
        overflow: hidden;
        transition: all 0.35s ease;
        border: 1px solid rgba(255,255,255,0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 12px 35px rgba(0,0,0,0.08), inset 0 1px 1px rgba(255,255,255,0.5);
        min-height: 100%;
    }

        .glass-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 45px rgba(0,0,0,0.14);
        }

    /* CARD COLORS */

    .education-card {
        background: linear-gradient( 135deg, rgba(99,102,241,0.16), rgba(129,140,248,0.22) );
    }

    .technology-card {
        background: linear-gradient( 135deg, rgba(14,165,233,0.16), rgba(59,130,246,0.22) );
    }

    .finance-card {
        background: linear-gradient( 135deg, rgba(16,185,129,0.16), rgba(5,150,105,0.22) );
    }

    .hr-card {
        background: linear-gradient( 135deg, rgba(236,72,153,0.16), rgba(219,39,119,0.22) );
    }

    .support-card {
        background: linear-gradient( 135deg, rgba(249,115,22,0.16), rgba(234,88,12,0.22) );
    }

    .student-card {
        background: linear-gradient( 135deg, rgba(168,85,247,0.16), rgba(147,51,234,0.22) );
    }

    .certificate-card {
        background: linear-gradient( 135deg, rgba(245,158,11,0.16), rgba(217,119,6,0.22) );
    }

    .skill-card {
        background: linear-gradient( 135deg, rgba(6,182,212,0.16), rgba(8,145,178,0.22) );
    }

    .ai-card {
        background: linear-gradient( 135deg, rgba(239,68,68,0.16), rgba(220,38,38,0.22) );
    }

    .library-card {
        background: linear-gradient( 135deg, rgba(132,204,22,0.16), rgba(101,163,13,0.22) );
    }

    .analytics-card {
        background: linear-gradient( 135deg, rgba(20,184,166,0.16), rgba(13,148,136,0.22) );
    }

    .collaboration-card {
        background: linear-gradient( 135deg, rgba(59,130,246,0.16), rgba(37,99,235,0.22) );
    }

    /* ICONS */

    .icon-area {
        width: 85px;
        height: 85px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        margin-bottom: 22px;
        background: linear-gradient( 135deg, rgba(255,255,255,0.90), rgba(255,255,255,0.60) );
        box-shadow: 0 10px 25px rgba(0,0,0,0.08), inset 0 1px 1px rgba(255,255,255,0.7);
    }

    /* TEXT */

    .glass-card h3 {
        font-size: 1.45rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 14px;
    }

    .glass-card p {
        color: #374151;
        line-height: 1.8;
        min-height: 140px;
        font-size: 0.96rem;
    }

    /* TAGS */

    .tag-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

        .tag-container span {
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.70);
            font-size: 0.82rem;
            font-weight: 600;
            color: #111827;
            box-shadow: 0 4px 10px rgba(0,0,0,0.04);
        }

    /* RESPONSIVE */

    @@media (max-width: 1200px) {

        .category-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {

        .category-grid {
            grid-template-columns: 1fr;
        }

        .academic-page {
            padding: 20px 12px 50px;
        }

        .hero-title {
            font-size: 2rem;
        }

        .hero-subtitle {
            font-size: 0.96rem;
        }

        .glass-card {
            padding: 22px;
            border-radius: 24px;
        }

        .icon-area {
            width: 72px;
            height: 72px;
            font-size: 2.2rem;
        }

        .glass-card p {
            min-height: auto;
        }
    }

    @@media (max-width: 480px) {

        .glass-card {
            padding: 20px;
        }

        .hero-title {
            font-size: 1.7rem;
        }

        .hero-subtitle {
            font-size: 0.92rem;
        }
    }

</style>