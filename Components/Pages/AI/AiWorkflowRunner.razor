
@page "/ai-workflow-runner"
@layout MainLayout

@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using MITANZ360Pro.Web.Services.AI

@inject IWebHostEnvironment Environment
@inject AiWorkflowEngine WorkflowEngine
@inject ILogger<AiWorkflowRunner> Logger

<PageTitle>AI Workflow Runner</PageTitle>

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <!-- HEADER -->

            <div class="card glass-card mb-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h2 class="fw-bold mb-1" style="color:orangered">
                                AI Workflow Runner
                            </h2>


                            <div class="workflow-card">
                                <h3>Technology Behind an AI Workflow Runner</h3>
                                <p>
                                    An AI Workflow Runner automates complex business processes by coordinating
                                    multiple technologies.
                                </p>

                                <div class="feature">
                                    <strong>Workflow Engine</strong>
                                    <span>Executes workflow steps in the correct sequence.</span>
                                </div>

                                <div class="feature">
                                    <strong>LLMs (AI Models)</strong>
                                    <span>Understand and generate intelligent responses.</span>
                                </div>

                                <div class="feature">
                                    <strong>APIs</strong>
                                    <span>Connect with external applications and services.</span>
                                </div>

                                <div class="feature">
                                    <strong>Database</strong>
                                    <span>Stores workflow data, history, and outputs.</span>
                                </div>

                                <div class="feature">
                                    <strong>Logic &amp; Conditions</strong>
                                    <span>Handles rules, branching, and decision-making.</span>
                                </div>

                                <div class="feature">
                                    <strong>Automation</strong>
                                    <span>Triggers workflows from events, schedules, or user requests.</span>
                                </div>

                                <hr>

                                <p>
                                    <strong>Result:</strong> Intelligent, scalable, and fully automated
                                    multi-step business workflows.
                                </p>
                            </div>

                        </div>

                        <div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- WORKFLOW -->

            <div class="card glass-card mb-4" style="background-color:antiquewhite">

                <div class="card-body">

                    <div class="row g-4 align-items-end">

                        <!-- WORKFLOW -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Workflow File
                            </label>

                            <select class="form-select"
                                    @bind="SelectedWorkflow">

                                <option value="">
                                    -- Select Workflow --
                                </option>

                                @foreach (var workflow in WorkflowFiles)
                                {
                                    <option value="@workflow">
                                        @workflow
                                    </option>
                                }

                            </select>

                        </div>

                        <!-- OUTPUT MODE -->

                        <div class="col-md-3">

                            <label class="form-label fw-semibold">
                                Response Mode
                            </label>

                            <select class="form-select"
                                    @bind="SelectedOutputMode">

                                <option value="@AiOutputMode.Text">
                                    Text
                                </option>

                                <option value="@AiOutputMode.Html">
                                    HTML
                                </option>

                                <option value="@AiOutputMode.JsonOnly">
                                    JSON
                                </option>

                                <option value="@AiOutputMode.Markdown">
                                    Markdown
                                </option>

                            </select>

                        </div>

                        <!-- BUTTON -->

                        <div class="col-md-3">

                            <button class="btn btn-primary w-100"
                                    @onclick="ExecuteWorkflowAsync"
                                    disabled="@IsLoading">

                                @if (IsLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2">
                                    </span>

                                    <span>
                                        Processing...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Run Workflow
                                    </span>
                                }

                            </button>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ERROR -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger glass-card">

                    @ErrorMessage

                </div>
            }

            <!-- RESPONSE -->
            @if (!string.IsNullOrWhiteSpace(Response))
            {
                <div class="card glass-card ai-result-card">

                    <div class="card-header ai-header">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <h5 class="mb-0 fw-bold">
                                    AI Workflow Result
                                </h5>

                                <small class="text-muted">
                                    Microsoft Enterprise AI Workspace
                                </small>

                            </div>

                            <div class="text-end">

                                <div class="badge bg-primary px-3 py-2">
                                    @SelectedOutputMode
                                </div>

                                <div class="small text-muted mt-1">
                                    @GeneratedAt
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="card-body ai-workspace-body">

                        @switch (SelectedOutputMode)
                        {
                            case AiOutputMode.Html:

                                <div class="ai-html-workspace">

                                    @((MarkupString)Response)

                                </div>

                                break;

                            case AiOutputMode.JsonOnly:

                                <div class="json-viewer">

                                    <pre>
@Response
                                    </pre>

                                </div>

                                break;

                            case AiOutputMode.Markdown:

                                <div class="markdown-viewer">

                                    <pre>
@Response
                                    </pre>

                                </div>

                                break;

                            default:

                                <div class="text-viewer">

                                    <div class="ai-text-content">

                                        @Response

                                    </div>

                                </div>

                                break;
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<style>

    :root {
        --ms-primary: #2563eb;
        --ms-primary-light: #dbeafe;
        --ms-bg: #f4f8fc;
        --ms-surface: rgba(255,255,255,0.72);
        --ms-border: rgba(255,255,255,0.45);
        --ms-shadow: 0 10px 30px rgba(15,23,42,0.08);
        --ms-text: #0f172a;
        --ms-muted: #64748b;
    }

    body {
        background: linear-gradient( 135deg, #eef5ff 0%, #f8fbff 50%, #edf4ff 100%);
        font-family: "Segoe UI", sans-serif;
        color: var(--ms-text);
    }

    /* =========================
           GLASS CARDS
        ========================== */

    .glass-card,
    .glass-card-inner {
        background: rgba(255,255,255,0.68);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
