@page "/admin/roles"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,SysAdmin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor

@using MITANZ360Pro.Web.Data

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Application Roles Management</PageTitle>

<div class="container mt-4 page-wrap">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->
    <div class="top-card mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="title mb-1">Application Roles Management</h3>
                <div class="subtle">Manage application roles and access permissions.</div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <RadzenTextBox @bind-Value="search"
                               Placeholder="Search roles..."
                               Style="width:300px;" />

                <RadzenButton Text="New Role"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="OpenCreateRoleBlade" />
            </div>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- GRID -->
    <!-- ===================================================== -->
    <div class="workspace-card">
        <RadzenDataGrid Data="@FilteredRoles()"
                        TItem="RoleRow"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        AllowFiltering="false"
                        Responsive="true"
                        Class="mit-grid">

            <Columns>
                <RadzenDataGridColumn TItem="RoleRow" Property="Name" Title="Role" />
                <RadzenDataGridColumn TItem="RoleRow" Property="NormalizedName" Title="Normalized Name" />
                <RadzenDataGridColumn TItem="RoleRow" Property="UsersCount" Title="Users" Width="120px" />

                <RadzenDataGridColumn TItem="RoleRow" Title="Actions" Sortable="false" Filterable="false" Width="160px">
                    <Template Context="r">
                        <div class="d-flex gap-2">
                            <RadzenButton Icon="edit"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@(async () => await OpenEditRoleBlade(r))" />

                            <RadzenButton Icon="delete"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Disabled="@busy"
                                          Click="@(async () => await AskDeleteRole(r))" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
    </div>
</div>

<!-- ===================================================== -->
<!-- ROLE SIDE PANEL -->
<!-- ===================================================== -->
<RadzenSidebar Position="SidebarPosition.Right"
               Visible="@showRoleBlade"
               Class="mit-blade">

    <div class="blade-header">
        <div class="d-flex align-items-center gap-2">
            <RadzenIcon Icon="@roleBladeIcon"
                        Style="@($"color:{roleBladeIconColor};")" />

            <h4 class="mb-0">@roleBladeTitle</h4>
        </div>

        <RadzenButton Icon="close"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@CloseRoleBlade" />
    </div>

    <div class="blade-body">
        <div class="row">
            <div class="col-12 mb-3">
                <RadzenLabel Text="Role Name" />
                <RadzenTextBox @bind-Value="model.Name"
                               Name="RoleName"
                               Style="width:100%;" />
            </div>

            @if (isEditMode)
            {
                <div class="col-12">
                    <div class="subtle">
                        Renaming a role updates the Identity role record. Ensure any seeded role names in code remain aligned.
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="blade-footer">
        <RadzenButton Text="Cancel"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@CloseRoleBlade"
                      Disabled="@busy" />

        <RadzenButton Text="Save"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@busy"
                      Click="AskSaveRole" />
    </div>
</RadzenSidebar>

@code
{
    // =====================================================
    // STATE
    // =====================================================

    private List<RoleRow> roles = new();

    private bool showRoleBlade;
    private bool busy;
    private bool isEditMode;

    private string search = string.Empty;

    private string roleBladeTitle = "New Role";
    private string roleBladeIcon = "add";
    private string roleBladeIconColor = "#2563eb";

    private RoleRow? editingRole;

    private RoleEditModel model = new();

    // Optional protection for critical roles used by authorization.
    private static readonly HashSet<string> ProtectedRoleNames =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "Admin",
            "SysAdmin"
        };

    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    // =====================================================
    // LOAD ROLES
    // =====================================================

    private async Task LoadRoles()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        roles = await
            (
                from r in db.Roles
                join ur in db.UserRoles on r.Id equals ur.RoleId into roleUsers
                where !string.IsNullOrWhiteSpace(r.Name)
                orderby r.Name
                select new RoleRow
                {
                    Id = r.Id,
                    Name = r.Name!,
                    NormalizedName = r.NormalizedName ?? string.Empty,
                    UsersCount = roleUsers.Count()
                }
            )
            .AsNoTracking()
            .ToListAsync();
    }

    // =====================================================
    // FILTER
    // =====================================================

    private IEnumerable<RoleRow> FilteredRoles()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return roles;
        }

        var s = search.Trim().ToLowerInvariant();

        return roles.Where(r =>
            (r.Name ?? string.Empty).ToLowerInvariant().Contains(s) ||
            (r.NormalizedName ?? string.Empty).ToLowerInvariant().Contains(s));
    }

    // =====================================================
    // CREATE
    // =====================================================

    private Task OpenCreateRoleBlade()
    {
        isEditMode = false;
        editingRole = null;

        model = new RoleEditModel
        {
            Name = string.Empty
        };

        roleBladeTitle = "New Role";
        roleBladeIcon = "add";
        roleBladeIconColor = "#2563eb";

        showRoleBlade = true;
        return Task.CompletedTask;
    }

    // =====================================================
    // EDIT
    // =====================================================

    private Task OpenEditRoleBlade(RoleRow role)
    {
        isEditMode = true;
        editingRole = role;

        model = new RoleEditModel
        {
            Id = role.Id,
            Name = role.Name
        };

        roleBladeTitle = "Edit Role";
        roleBladeIcon = "security";
        roleBladeIconColor = "#ea580c";

        showRoleBlade = true;
        return Task.CompletedTask;
    }

    // =====================================================
    // SAVE
    // =====================================================

    private async Task AskSaveRole()
    {
        try
        {
            busy = true;

            var validationError = ValidateModel();
            if (!string.IsNullOrWhiteSpace(validationError))
            {
                Notify(validationError, NotificationSeverity.Error);
                return;
            }

            using var scope = ScopeFactory.CreateScope();

            var roleManager = scope.ServiceProvider.GetRequiredService<RoleManager<IdentityRole>>();

            var trimmedName = model.Name.Trim();

            if (!isEditMode)
            {
                var exists = await roleManager.RoleExistsAsync(trimmedName);
                if (exists)
                {
                    Notify("A role with this name already exists.", NotificationSeverity.Error);
                    return;
                }

                var createResult = await roleManager.CreateAsync(new IdentityRole(trimmedName));
                if (!createResult.Succeeded)
                {
                    NotifyIdentityErrors(createResult);
                    return;
                }

                Notify("Role created");
            }
            else
            {
                var role = await roleManager.FindByIdAsync(model.Id!);
                if (role is null)
                {
                    Notify("Role not found.", NotificationSeverity.Error);
                    return;
                }

                if (ProtectedRoleNames.Contains(role.Name ?? string.Empty) &&
                    !string.Equals(role.Name, trimmedName, StringComparison.OrdinalIgnoreCase))
                {
                    Notify("Protected system roles cannot be renamed.", NotificationSeverity.Error);
                    return;
                }

                var duplicate = await roleManager.FindByNameAsync(trimmedName);
                if (duplicate is not null &&
                    !string.Equals(duplicate.Id, role.Id, StringComparison.Ordinal))
                {
                    Notify("Another role with this name already exists.", NotificationSeverity.Error);
                    return;
                }

                role.Name = trimmedName;
                role.NormalizedName = trimmedName.ToUpperInvariant();

                var updateResult = await roleManager.UpdateAsync(role);
                if (!updateResult.Succeeded)
                {
                    NotifyIdentityErrors(updateResult);
                    return;
                }

                Notify("Role updated");
            }

            showRoleBlade = false;

            await LoadRoles();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // =====================================================
    // DELETE
    // =====================================================

    private async Task AskDeleteRole(RoleRow role)
    {
        try
        {
            if (ProtectedRoleNames.Contains(role.Name))
            {
                Notify("Protected system roles cannot be deleted.", NotificationSeverity.Error);
                return;
            }

            if (role.UsersCount > 0)
            {
                Notify("This role is assigned to users and cannot be deleted.", NotificationSeverity.Error);
                return;
            }

            var confirmed = await DialogService.Confirm(
                $"Delete role '{role.Name}'?",
                "Confirm delete",
                new ConfirmOptions
                {
                    OkButtonText = "Delete",
                    CancelButtonText = "Cancel"
                });

            if (confirmed != true)
            {
                return;
            }

            busy = true;

            using var scope = ScopeFactory.CreateScope();

            var roleManager = scope.ServiceProvider.GetRequiredService<RoleManager<IdentityRole>>();

            var dbRole = await roleManager.FindByIdAsync(role.Id);
            if (dbRole is null)
            {
                Notify("Role not found.", NotificationSeverity.Error);
                return;
            }

            var deleteResult = await roleManager.DeleteAsync(dbRole);
            if (!deleteResult.Succeeded)
            {
                NotifyIdentityErrors(deleteResult);
                return;
            }

            Notify("Role deleted");

            await LoadRoles();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // =====================================================
    // HELPERS
    // =====================================================

    private string? ValidateModel()
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            return "Role name is required.";
        }

        if (model.Name.Trim().Length < 2)
        {
            return "Role name must be at least 2 characters.";
        }

        return null;
    }

    private void NotifyIdentityErrors(IdentityResult result)
    {
        Notify(
            string.Join(", ", result.Errors.Select(x => x.Description)),
            NotificationSeverity.Error);
    }

    private void CloseRoleBlade()
    {
        showRoleBlade = false;
    }

    private void Notify(
        string message,
        NotificationSeverity severity = NotificationSeverity.Success)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = message,
            Duration = 3000
        });
    }

    // =====================================================
    // VIEW MODELS
    // =====================================================

    private sealed class RoleRow
    {
        public string Id { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string NormalizedName { get; set; } = string.Empty;

        public int UsersCount { get; set; }
    }

    private sealed class RoleEditModel
    {
        public string? Id { get; set; }

        public string Name { get; set; } = string.Empty;
    }
}
``