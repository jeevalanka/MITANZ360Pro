@namespace MITANZ360Pro.Web.Components.Layout
@inherits LayoutComponentBase

@using MITANZ360Pro.Web.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen
@using Radzen.Blazor
@using MITANZ360Pro.Web.Components.Layout
@using Microsoft.Extensions.Options
@using MITANZ360Pro.Web.Models

@inject IOptions<ApplicationSettings> AppSettings
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject HttpClient Http

@{
    RenderFragment? bodyContent = Body;
}

<ErrorBoundary>
    <ChildContent>

        <RadzenDialog />
        <RadzenNotification />
        <RadzenTooltip />
        <RadzenContextMenu />

        <div class="page">

            <!-- MAIN -->
            <main>

                <!-- TOP BAR -->
                <div class="top-row">

                    <div class="top-left">
                        <NavLink href="/" class="logo-link">
                            <img src="images/Logo-v2.png" class="app-logo" />
                        </NavLink>
                        @if (AppSettings?.Value.Name != null)
                        {
                            <span class="app-title" style="color:goldenrod">
                                @AppSettings.Value.Name
                            </span>
                        }
                    </div>

                    <div class="top-right">

                        <div class="user-info">
                            <AuthorizeView>
                                <NotAuthorized>
                                    <NavLink href="/xlogin" class="user-icon-link">
                                        <i class="bi bi-person-circle"></i>
                                    </NavLink>
                                </NotAuthorized>

                                <Authorized>
                                    <span class="user-icon-link">
                                        <i class="bi bi-person-circle"></i>
                                    </span>
                                </Authorized>
                            </AuthorizeView>

                            <div class="user-text-inline">
                                <span class="user-name">@(_displayName ?? "Guest")</span>
                                <span class="user-role">@(_rolesText ?? "")</span>
                            </div>
                        </div>

                        <div class="top-icons">
                            <button class="top-icon-btn"
                                    @onclick='() => Navigation.NavigateTo("/")'>
                                <i class="bi bi-house"></i>
                            </button>
                            <AuthorizeView>
                                <Authorized>
                                    <button class="top-icon-btn" @onclick="Logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>

                    </div>

                </div>

                <!-- CONTENT + RIGHT PANEL -->
                <div class="content-wrapper">

                    <!-- MAIN CONTENT -->
                    <article class="content">
                        @bodyContent
                    </article>

                </div>

            </main>
        </div>

    </ChildContent>

    <ErrorContent>
        <div class="alert alert-danger m-3">
            Something went wrong. Refresh the page.
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool sidebarCollapsed = true;

    private string? _displayName;
    private string _rolesText = "";

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName = user.Identity.Name;

            var roles = user.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();

            _rolesText = roles.Count > 0 ? string.Join(", ", roles) : "";
        }
        else
        {
            _displayName = "Guest";
            _rolesText = "";
        }
    }

    private async Task Logout()
    {
        Navigation.NavigateTo("xlogin", true);
    }
}

<style>

    /* =========================================
       GLOBAL PAGE LAYOUT
    ========================================= */
    .page {
        display: flex;
        height: 100vh;
        overflow: hidden;
        background: #0f1115;
    }

    /* SIDEBAR */
    .sidebar {
        background: linear-gradient(180deg, #0b0b0b, #121212);
        transition: width 0.3s ease;
        display: flex;
        flex-direction: column;
        box-shadow: 2px 0 10px rgba(0,0,0,0.5);
    }

        .sidebar.expanded {
            width: 220px;
        }

        .sidebar.collapsed {
            width: 70px;
        }

    /* LOGO */
    .logo-link {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 12px;
    }

    .app-logo {
        width: 100%;
        max-width: 150px;
    }

    /* MAIN */
    main {
        display: flex;
        flex-direction: column;
        flex: 1;
        height: 100vh;
        overflow: hidden;
    }

    /* TOP BAR */
    .top-row {
        height: 60px;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(6px);
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 15px;
        border-bottom: 2px solid orange;
    }

    /* LEFT TOP */
    .top-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .app-title {
        font-weight: bold;
        color: orange;
        font-size: 18px;
    }

    /* BURGER */
    .burger-btn {
        background: transparent;
        border: none;
        color: orange;
        font-size: 22px;
        cursor: pointer;
    }

    /* RIGHT TOP */
    .top-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .user-icon-link {
        color: orange;
        font-size: 22px;
    }

    .user-name {
        color: #4ea1ff;
        font-weight: 500;
    }

    .user-role {
        font-size: 11px;
        color: #aaa;
    }

    /* ICONS */
    .top-icons {
        display: flex;
        gap: 10px;
    }

    .top-icon-btn {
        background: transparent;
        border: none;
        color: orange;
        font-size: 18px;
        cursor: pointer;
    }

    /* CONTENT WRAPPER */
    .content-wrapper {
        display: flex;
        flex: 1;
        overflow: hidden;
    }

    /* MAIN CONTENT */
    .content {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
        background: #f4f6f9;
        min-width: 0;
    }

    /* =========================================
       🔥 RIGHT PANEL FIX (IMPORTANT)
    ========================================= */

    /* BASE (NO FIXED WIDTH) */
    .right-panel-container {
        background: linear-gradient(180deg, #0b0b0b, #121212);
        border-left: 1px solid rgba(255,255,255,0.08);
        overflow-y: auto;
        transition: all 0.3s ease;
    }

    /* SHOW */
    .show-panel {
        width: 300px;
        min-width: 300px;
        max-width: 300px;
        opacity: 1;
    }

    /* HIDE (ZERO WIDTH — NO SPACE) */
    .hide-panel {
        width: 0 !important;
        min-width: 0 !important;
        max-width: 0 !important;
        opacity: 0;
        overflow: hidden;
        flex: 0 0 0 !important;
    }

    /* =========================================
       SCROLLBAR
    ========================================= */
    .content::-webkit-scrollbar,
    .right-panel-container::-webkit-scrollbar {
        width: 6px;
    }

    .content::-webkit-scrollbar-thumb,
    .right-panel-container::-webkit-scrollbar-thumb {
        background: #444;
        border-radius: 4px;
    }

    /* RESPONSIVE */
    @@media (max-width: 900px) {
        .right-panel-container {
            display: none;
        }

        .sidebar.expanded {
            width: 180px;
        }
    }

</style>