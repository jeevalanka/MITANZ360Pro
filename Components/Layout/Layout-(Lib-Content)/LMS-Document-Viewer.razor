@page "/lms-view/{ItemId}"
@layout MainLayout_No_Left_RightPan

@inject NavigationManager Nav

<PageTitle>Document Viewer</PageTitle>

<style>
    .viewer-layout {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #F8FAFC;
    }

    .viewer-header {
        height: 60px;
        background: linear-gradient(135deg, #2563EB, #1E3A8A);
        color: white;
        display: flex;
        align-items: center;
        padding: 0 20px;
        gap: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.15);
    }

    .viewer-title {
        font-size: 14px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-back {
        background: rgba(255,255,255,.2);
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        color: white;
        cursor: pointer;
    }

    .viewer-body {
        flex: 1;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pdf-viewer {
        width: 100%;
        height: 100%;
        border: none;
        border-radius: 10px;
        background: white;
    }

    .toolbar {
        display: flex;
        gap: 10px;
        align-items: center;
        background: white;
        padding: 10px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,.08);
    }

        .toolbar button {
            border: 1px solid #e2e8f0;
            background: #fff;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

            .toolbar button:hover {
                background: #eff6ff;
                border-color: #2563EB;
            }

    .loading {
        text-align: center;
        padding: 50px;
        font-size: 14px;
        color: #475569;
    }
</style>

<div class="viewer-layout">

    <!-- HEADER -->
    <div class="viewer-header">
        <button class="btn-back" @onclick="GoBack">← Back</button>
        <div class="viewer-title">Document Viewer</div>
    </div>

    <!-- BODY -->
    <div class="viewer-body">

        @if (string.IsNullOrEmpty(FileUrl))
        {
            <div class="loading">Loading document...</div>
        }
        else
        {
            <!-- TOOLBAR -->
            <div class="toolbar">
                <button @onclick="Reload">🔄 Reload</button>
                <button @onclick="OpenInNewTab">🔗 Open</button>
                <button @onclick="Download">⬇ Download</button>
            </div>

            <!-- DOCUMENT VIEWER -->
            <iframe src="@FileUrl" class="pdf-viewer"></iframe>
        }

    </div>

</div>

@code {

    [Parameter] public string ItemId { get; set; } = "";

    private string FileUrl = "";

    protected override void OnInitialized()
    {
        // ✅ Always use streaming endpoint
        FileUrl = $"/api/files/{ItemId}";
    }

    private void GoBack()
    {
        Nav.NavigateTo("/lms-library-introduction");
    }

    private void Reload()
    {
        FileUrl = $"/api/files/{ItemId}?t={DateTime.Now.Ticks}";
    }

    private void OpenInNewTab()
    {
        Nav.NavigateTo($"/api/files/{ItemId}", true);
    }

    private void Download()
    {
        Nav.NavigateTo($"/api/files/{ItemId}?download=true", true);
    }
}