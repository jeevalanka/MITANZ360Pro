@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout_No_Left_RightPan)" />
        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(MainLayout_No_Left_RightPan)">
                <p>Page-Not-Found / Not-Authorized</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>