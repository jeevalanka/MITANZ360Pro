        border-radius: 24px;
        box-shadow: 0 8px 30px rgba(15,23,42,0.06);
        transition: all 0.25s ease;
    }

        .glass-card-inner:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(15,23,42,0.08);
        }

    /* =========================
