    void SeedDemo()
    {
        var rnd = new Random();

        LastRefreshed = DateTime.Now;

        // KPI
        HealthScore = rnd.Next(92, 100);
        UptimeText = $"{rnd.Next(12, 42)}d {rnd.Next(0, 23)}h";

        CriticalAlerts = rnd.Next(0, 6);
        WarningAlerts = rnd.Next(2, 14);
        Alerts24h = CriticalAlerts + WarningAlerts + rnd.Next(6, 20);
        TopAlertSource = new[] { "Identity", "Firewall", "Audit", "API Gateway", "DB" }[rnd.Next(0, 5)];

        TotalUsers = rnd.Next(120, 560);
        Admins = rnd.Next(2, 10);
        LockedOut = rnd.Next(0, 4);
        TwoFactorCoverage = rnd.Next(65, 98);

        JobsRunning = rnd.Next(1, 6);
        JobsQueued = rnd.Next(0, 12);
        JobsFailed = rnd.Next(0, 3);
        NextBackup = DateTime.Now.AddHours(rnd.Next(1, 12)).ToString("HH:mm");

        CpuNow = rnd.Next(10, 85);
        RamNow = rnd.Next(20, 90);
        DbLatencyMs = rnd.Next(20, 280);
        ReqPerMin = rnd.Next(240, 1800);

        // Timeseries (12 points)
        CpuSeries = BuildSeries(rnd, 12, 10, 95);
        RamSeries = BuildSeries(rnd, 12, 15, 95);
        DbLatencySeries = BuildSeries(rnd, 12, 10, 320);
        TrafficSeries = BuildSeries(rnd, 12, 120, 2200);

        PeakRpm = TrafficSeries.Max(x => x.Value);
        ErrorRate24h = Math.Round(rnd.NextDouble() * 0.35, 2);

        ErrorMix = new List<PieSlice>
        {
            new("4xx", rnd.Next(8, 28)),
            new("5xx", rnd.Next(1, 8)),
            new("Timeout", rnd.Next(1, 10)),
            new("Auth", rnd.Next(1, 6))
        };

        DbHealth = DbLatencyMs < 150 ? "OK" : DbLatencyMs < 250 ? "Degraded" : "Critical";
        DbPoolHealth = rnd.Next(70, 100);
        IndexFragmentation = rnd.Next(2, 35);
        StorageUsage = rnd.Next(30, 88);

        // Alerts stream
        Alerts = BuildAlerts(rnd);
        FilteredAlerts = Alerts.ToList();

        // Services
        Services = new List<ServiceStatus>
        {
            new("Identity", "admin_panel_settings", "Healthy", "Token + cookie auth OK", "Healthy", "#22C55E"),
            new("Database", "database", DbHealth, $"Latency {DbLatencyMs}ms", DbHealth, DbHealth == "OK" ? "#22C55E" : DbHealth == "Degraded" ? "#F59E0B" : "#EF4444"),
            new("Notifications", "notifications", "Healthy", "Email + in-app OK", "Healthy", "#22C55E"),
            new("Jobs Runner", "sync", JobsFailed > 0 ? "Degraded" : "Healthy", $"{JobsRunning} running / {JobsQueued} queued", JobsFailed > 0 ? "Degraded" : "Healthy", JobsFailed > 0 ? "#F59E0B" : "#22C55E"),
            new("Audit", "policy", "Healthy", "Events streaming", "Healthy", "#22C55E"),
        };

        // Jobs
        Jobs = new List<JobItem>
        {
            new("DB Backup", JobsFailed > 0 ? "Failed" : "Running", $"{rnd.Next(0,12)}m"),
            new("Cleanup Temp", "Queued", "—"),
            new("Reindex", DbHealth == "OK" ? "Running" : "Queued", $"{rnd.Next(1,30)}m"),
            new("Email Digest", "Queued", "—"),
            new("Audit Export", "Running", $"{rnd.Next(0,8)}m"),
            new("Cache Warmup", "Completed", $"{rnd.Next(1,5)}m"),
        };
    }

    List<MetricPoint> BuildSeries(Random rnd, int count, int min, int max)
    {
        var now = DateTime.Now;
        var points = new List<MetricPoint>();
        for (int i = count - 1; i >= 0; i--)
        {
            var t = now.AddMinutes(-i * 5);
            points.Add(new MetricPoint(t.ToString("HH:mm"), rnd.Next(min, max)));
        }
        return points;
    }

    List<SecurityAlert> BuildAlerts(Random rnd)
    {
        var now = DateTime.Now;
        var severities = new[] { "Info", "Warning", "Critical" };
        var cats = new[] { "Identity", "RBAC", "Firewall", "Data", "Audit", "API" };
        var msgs = new[]
        {
            "Failed sign-in attempts exceeded threshold",
            "New admin role assignment",
            "Suspicious IP detected",
            "Audit export requested",
            "Policy updated",
            "Rate limit triggered",
            "Password reset initiated"
        };

        var list = new List<SecurityAlert>();
        for (int i = 0; i < 18; i++)
        {
            var sev = severities[rnd.Next(0, severities.Length)];
            list.Add(new SecurityAlert
            {
                Time = now.AddMinutes(-rnd.Next(5, 720)),
                Severity = sev,
                Category = cats[rnd.Next(0, cats.Length)],
                User = rnd.NextDouble() > 0.2 ? $"user{rnd.Next(1,120)}@mitanz.local" : "sysadmin@mitanz.local",
                Message = msgs[rnd.Next(0, msgs.Length)],
                SourceIp = $"{rnd.Next(10, 223)}.{rnd.Next(0, 255)}.{rnd.Next(0, 255)}.{rnd.Next(1, 254)}"
            });
        }
        return list.OrderByDescending(x => x.Time).ToList();
    }

    void ApplyFilter()
    {
        IEnumerable<SecurityAlert> q = Alerts;

        if (AlertFilter != "All")
            q = q.Where(a => a.Severity.Equals(AlertFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var s = SearchText.Trim();
            q = q.Where(a =>
                (a.User?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Message?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.SourceIp?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Category?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredAlerts = q.ToList();
    }

    void Refresh()
    {
        SeedDemo();
        ApplyFilter();
        Notifications.Notify(NotificationSeverity.Info, "Dashboard refreshed", "Sample data regenerated.");
    }

