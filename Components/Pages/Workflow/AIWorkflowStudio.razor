@page "/ai-workflow-studio"
@layout MainLayout_No_Left_RightPan
@attribute [Authorize(Roles = "Admin,SysAdmin")]

@using System.Text.Json
@using MITANZ360Pro.Web.Models.Workflow
@using MITANZ360Pro.Web.Services.Workflow.Engine
@using MITANZ360Pro.Web.Services.Workflow.Validation
@using MITANZ360Pro.Web.Services.Workflow.Plugins

@inject IJSRuntime JS
@inject WorkflowExecutionService WorkflowService
@inject WorkflowValidator Validator
@inject WorkflowPluginManager PluginManager
@inject NavigationManager Navigation

<PageTitle>AI Workflow Studio</PageTitle>

<link href="css/workflowstudio.css" rel="stylesheet" />

<div class="wf-page">

    <div class="container-fluid p-0 wf-studio d-flex flex-column">

        <!-- Ribbon -->
        <div class="border-bottom bg-white shadow-sm p-2 flex-shrink-0">
            <div class="btn-toolbar gap-2">

                <div class="btn-group">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NewWorkflow">
                        <i class="bi bi-plus-circle"></i> New
                    </button>

                    <button type="button" class="btn btn-primary"
                            disabled="@(!CanSave)"
                            @onclick="SaveWorkflow">
                        Save
                    </button>

                    <button type="button" class="btn btn-outline-danger"
                            disabled="@(!CanDelete)"
                            @onclick="ConfirmWorkflowDelete">
                        Delete
                    </button>
                </div>

                <div class="btn-group">
                    <button type="button"
                            class="btn btn-success"
                            disabled="@(!CanExecute)"
                            @onclick="ExecuteWorkflow"
                            @onclick:preventDefault>
                        Execute
                    </button>

                    <button type="button" class="btn btn-warning"
                            disabled="@(Workflow is null)"
                            @onclick="ValidateWorkflow">
                        Validate
                    </button>

                    <button type="button" class="btn btn-outline-secondary ms-1"
                            @onclick="RefreshWorkflows">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

            </div>
        </div>
        
        <!-- Main -->
        <div class="row g-0 flex-grow-1 overflow-auto">

            <!-- Explorer -->
            <div class="col-2 border-end bg-light">
                <div class="p-2 border-bottom">
                    <input class="form-control form-control-sm"
                           placeholder="Search workflow..."
                           @bind="SearchText" />
                </div>

                <div class="list-group list-group-flush">
                    @foreach (var file in FilteredWorkflows)
                    {
                        <button class="list-group-item list-group-item-action"
                                @onclick="() => LoadWorkflow(file)">
                            <i class="bi bi-diagram-3 me-2"></i>
                            @System.IO.Path.GetFileNameWithoutExtension(file)
                        </button>
                    }
                </div>
            </div>

            <!-- Toolbox -->
            <div class="col-2 border-end bg-white">
                <div class="p-2 fw-bold border-bottom">Plugins</div>

                <div class="list-group list-group-flush">
                    @foreach (var plugin in Plugins)
                    {
                        <button class="list-group-item list-group-item-action"
                                @onclick="() => AddPlugin(plugin.Type)">
                            <i class="bi bi-box me-2"></i>
                            @plugin.Type
                        </button>
                    }
                </div>
            </div>

            <!-- Designer -->
            <div class="col-5 bg-body">
                <div class="p-3">

                    @if (Workflow is null)
                    {
                        <div class="alert alert-info p-4">

                            <h5 class="mb-3">
                                🧠 AI Workflow Studio – Quick Guide
                            </h5>
                            <code>Scrape🌐🔎📡→Process⚙️🧩🔄→Save💾🗄️📂→Notify🔔📩📢</code>

                            <ol class="mb-3">
                                <li>
                                    <strong>Create or Load Workflow</strong><br />
                                    Click <b>New</b> to start or select a workflow from the left panel.
                                </li>

                                <li class="mt-2">
                                    <strong>Add Steps</strong><br />
                                    Use the <b>Plugins</b> panel to add steps like HTTP, SQL, Email, or File.
                                </li>

                                <li class="mt-2">
                                    <strong>Configure Step</strong><br />
                                    Select a step to edit its properties on the right panel.
                                </li>

                                <li class="mt-2">
                                    <strong>Arrange Order</strong><br />
                                    Adjust execution order using the <b>Order</b> field.
                                </li>

                                <li class="mt-2">
                                    <strong>Validate Workflow</strong><br />
                                    Click <b>Validate</b> to check for errors.
                                </li>

                                <li class="mt-2">
                                    <strong>Execute Workflow</strong><br />
                                    Click <b>Execute</b> to run and view results in the console below.
                                </li>

                                <li class="mt-2">
                                    <strong>Save Your Work</strong><br />
                                    Click <b>Save</b> to store your workflow.
                                </li>
                            </ol>

                            <div class="mt-3">
                                <strong class="text-primary">
                                    💡 Tip:
                                </strong>
                                You can combine multiple steps to build automation pipelines such as:
                                <br />
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="card shadow-lg border-0 workflow-card">

                            <div class="card-header">
                                <strong>@Workflow.Name</strong>
                            </div>

                            <div class="card-body">

                                <div class="mb-3">
                                    <label class="form-label">Workflow Name</label>
                                    <input class="form-control" @bind="Workflow.Name" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" rows="3"
                                              @bind="Workflow.Description"></textarea>
                                </div>

                                <h6 class="border-bottom pb-2">Workflow Steps</h6>

                                <div class="list-group">
                                    @foreach (var step in Workflow.DataSources.OrderBy(x => x.Order))
                                    {
                                        <button class="list-group-item list-group-item-action"
                                                @onclick="() => SelectStep(step)">
                                            <div class="d-flex justify-content-between">

                                                <span>
                                                    <strong>@step.Name</strong>
                                                    <span class="badge bg-secondary ms-2">
                                                        @step.Type
                                                    </span>
                                                </span>

                                                <span>Order: @step.Order</span>

                                            </div>
                                        </button>
                                    }
                                </div>

                            </div>

                        </div>
                    }

                </div>
            </div>

            <!-- Properties (FULL RESTORED) -->
            <div class="col-3 border-start bg-light">
                <div class="p-3">

                    <h6 class="border-bottom pb-2">Properties</h6>
                    @if (SelectedStep is not null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" @bind="SelectedStep.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Type</label>
                            <input class="form-control" @bind="SelectedStep.Type" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Output</label>
                            <input class="form-control" @bind="SelectedStep.Output" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Order</label>
                            <input class="form-control" type="number" @bind="SelectedStep.Order" />
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox"
                                   @bind="SelectedStep.Enabled" />
                            <label class="form-check-label">Enabled</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox"
                                   @bind="SelectedStep.ContinueOnError" />
                            <label class="form-check-label">
                                Continue On Error
                            </label>
                        </div>

                        @* SCRAPE / HTTP *@
                        @if (SelectedStep.Type.Equals("scrape", StringComparison.OrdinalIgnoreCase) ||
                             SelectedStep.Type.Equals("http", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">URL</label>
                                <input class="form-control"
                                       value="@GetSetting("url")"
                                       @onchange="SetUrl" />
                            </div>
                        }
                        @if (SelectedStep.Type.Equals("http", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">Method</label>
                                <select class="form-select"
                                        value="@GetSetting("method")"
                                        @onchange="SetMethod">
                                    <option>GET</option>
                                    <option>POST</option>
                                    <option>PUT</option>
                                    <option>DELETE</option>
                                </select>
                            </div>
                        }

                        @* FILE *@
                        @if (SelectedStep.Type.Equals("file", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">Operation</label>
                                <select class="form-select"
                                        value="@GetSetting("operation")"
                                        @onchange="SetFileOperation">

                                    <option value="Read">Read</option>
                                    <option value="Write">Write</option>
                                    <option value="Append">Append</option>
                                    <option value="Delete">Delete</option>
                                    <option value="Copy">Copy</option>
                                    <option value="Move">Move</option>
                                    <option value="List">List</option>

                                    <option value="SaveHtml">SaveHtml</option>
                                    <option value="SaveMarkdown">SaveMarkdown</option>
                                    <option value="SaveJson">SaveJson</option>
                                    <option value="SaveCsv">SaveCsv</option>

                                    <option value="UploadToSharePoint">
                                        UploadToSharePoint
                                    </option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Input</label>
                                <input class="form-control"
                                       value="@GetSetting("input")"
                                       @onchange="SetFileInput" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">File Path</label>
                                <input class="form-control"
                                       value="@GetSetting("path")"
                                       @onchange="SetPath" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Destination</label>
                                <input class="form-control"
                                       value="@GetSetting("destination")"
                                       @onchange="SetDestination" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    File Name
                                </label>

                                <input class="form-control"
                                       value="@GetSetting("fileName")"
                                       @onchange="SetFileName" />
                            </div>
                        }

                        @* SQL *@
                        @if (SelectedStep.Type.Equals("sql", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">Connection</label>
                                <input class="form-control"
                                       value="@GetSetting("connection")"
                                       @onchange="SetConnection" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">SQL Query</label>
                                <textarea rows="5" class="form-control"
                                          @onchange="SetQuery">@GetSetting("query")</textarea>
                            </div>
                        }

                        @* EMAIL *@
                        @if (SelectedStep.Type.Equals("email", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">To</label>
                                <input class="form-control"
                                       value="@GetSetting("to")"
                                       @onchange="SetEmailTo" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Subject</label>
                                <input class="form-control"
                                       value="@GetSetting("subject")"
                                       @onchange="SetEmailSubject" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Body</label>
                                <textarea rows="5" class="form-control"
                                          @onchange="SetEmailBody">@GetSetting("body")</textarea>
                            </div>
                        }


                        @* SHAREPOINT *@
                        @if (SelectedStep.Type.Equals("sharepoint", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">Site URL</label>
                                <input class="form-control"
                                       value="@GetSetting("siteUrl")"
                                       @onchange="SetSiteUrl" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">List Name</label>
                                <input class="form-control"
                                       value="@GetSetting("listName")"
                                       @onchange="SetListName" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Operation</label>
                                <select class="form-select"
                                        value="@GetSetting("operation")"
                                        @onchange="SetOperation">
                                    <option value="read">Read</option>
                                    <option value="create">Create</option>
                                    <option value="update">Update</option>
                                    <option value="delete">Delete</option>
                                </select>
                            </div>
                        }

                        @* AI *@
                        @if (SelectedStep.Type.Equals("ai", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-3">
                                <label class="form-label">Provider</label>
                                <InputSelect class="form-select"
                                             @bind-Value="AiProvider">
                                    <option value="AzureOpenAI">Azure OpenAI</option>
                                    <option value="OpenAI">OpenAI</option>
                                    <option value="OpenRouter">OpenRouter</option>
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Model</label>
                                <InputText class="form-control"
                                           @bind-Value="AiModel" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Prompt</label>
                                <InputTextArea rows="6"
                                               class="form-control"
                                               @bind-Value="AiPrompt" />
                            </div>
                        }

                        <div class="mt-3">
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm w-100"
                                    @onclick="ShowDeleteConfirmation">
                                Remove Step
                            </button>
                        </div>
                        @if (ShowDeleteDialog)
                        {
                            <div class="modal fade show d-block"
                                 style="background:rgba(0,0,0,.5);">

                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">

                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title">
                                                Confirm Delete
                                            </h5>
                                        </div>

                                        <div class="modal-body">
                                            Are you sure you want to delete
                                            <strong>@SelectedStep?.Name</strong>?
                                        </div>

                                        <div class="modal-footer">

                                            <button class="btn btn-secondary"
                                                    @onclick="CancelDelete">
                                                Cancel
                                            </button>

                                            <button class="btn btn-danger"
                                                    @onclick="@(() => DeleteConfirmed())">
                                                Delete
                                            </button>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>

        </div>

        @* ✅ PLACE WORKFLOW DELETE MODAL HERE *@
        @if (ShowWorkflowDeleteDialog)
        {
            <div class="modal fade show d-block"
                 style="background:rgba(0,0,0,.5);">

                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                Confirm Workflow Delete
                            </h5>
                        </div>

                        <div class="modal-body">
                            Are you sure you want to delete workflow
                            <strong>@Workflow?.Name</strong>?
                        </div>

                        <div class="modal-footer">

                            <button class="btn btn-secondary"
                                    @onclick="CancelWorkflowDelete">
                                Cancel
                            </button>

                            <button class="btn btn-danger"
                                    @onclick="DeleteWorkflowConfirmed">
                                Delete
                            </button>

                        </div>

                    </div>
                </div>
            </div>
        }


        <!-- ✅ Console Footer -->
        <div class="wf-console border-top bg-dark text-light p-3 flex-shrink-0">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong class="text-warning">Workflow Console</strong>
                    <span class="ms-2 badge bg-secondary">@Logs.Count</span>
                </div>

                <button class="btn btn-sm btn-outline-light"
                        @onclick="ClearLogs">
                    <i class="bi bi-trash"></i> Clear
                </button>
            </div>

            <div style="max-height:200px; overflow-y:auto;">
                @if (!Logs.Any())
                {
                    <div class="text-secondary">No log entries available.</div>
                }
                else
                {
                    @foreach (var line in Logs)
                    {
                        <div class="py-1 px-2 mb-1 rounded"
                             style="background:#1f2937;color:white;">
                            @line
                        </div>
                    }
                }
            </div>

        </div>

    </div>

</div>

@code
{
    private WorkflowDefinition? Workflow;

    private WorkflowStep? SelectedStep;

    private WorkflowContext? Result;

    private List<string> WorkflowFiles = [];

    private List<string> Logs = [];

    private string SearchText = string.Empty;

    private IReadOnlyCollection<IWorkflowPlugin> Plugins = [];

    private bool ShowDeleteDialog;

    private bool ShowWorkflowDeleteDialog;

    private string AiModel
    {
        get => GetSetting("model");
        set => SetSetting("model", value);
    }

    private string AiPrompt
    {
        get => GetSetting("prompt");
        set => SetSetting("prompt", value);
    }

    private void SetOperation(ChangeEventArgs e)
    {
        SelectedStep!.Settings["operation"] =
            e.Value?.ToString() ?? "read";
    }

    private void ConfirmWorkflowDelete()
    {
        ShowWorkflowDeleteDialog = true;
    }

    private void CancelWorkflowDelete()
    {
        ShowWorkflowDeleteDialog = false;
    }

    private async Task DeleteWorkflowConfirmed()
    {
        ShowWorkflowDeleteDialog = false;

        await DeleteWorkflow();
    }

    protected override async Task OnInitializedAsync()
    {
        WorkflowFiles = await WorkflowService.GetWorkflowsAsync();

        Plugins = PluginManager.GetAll();
    }

    private IEnumerable<string> FilteredWorkflows =>
        string.IsNullOrWhiteSpace(SearchText)
            ? WorkflowFiles
            : WorkflowFiles.Where(x =>
                x.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase));

    private bool CanSave => Workflow is not null;

    private bool CanDelete => Workflow is not null;

    private bool CanExecute =>
      Workflow is not null &&
      Workflow.DataSources.Any(s => s.Enabled);

    private string AiProvider
    {
        get => GetSetting("provider") ?? "AzureOpenAI";
        set
        {
            if (SelectedStep is not null)
            {
                SelectedStep.Settings["provider"] = value;
            }
        }
    }

    private void NewWorkflow()
    {
        Workflow = new WorkflowDefinition
        {
            Name = "New Workflow"
        };

        SelectedStep = null;

        Log("Workflow created.");
    }

    private async Task LoadWorkflow(string file)
    {
        Workflow = await WorkflowService.LoadAsync(file);

        SelectedStep = null;

        Log($"Loaded {file}");
    }

    private async Task SaveWorkflow()
    {
        if (Workflow is null)
            return;

        await WorkflowService.SaveAsync(Workflow);

        WorkflowFiles =
            await WorkflowService.GetWorkflowsAsync();

        Log("Workflow saved.");

        StateHasChanged();
    }

    private async Task DeleteWorkflow()
    {
        if (Workflow is null)
            return;

        await WorkflowService.DeleteAsync(
            $"{Workflow.Name}.json");

        Workflow = null;

        SelectedStep = null;

        WorkflowFiles =
            await WorkflowService.GetWorkflowsAsync();

        Log("Workflow deleted.");

        StateHasChanged();
    }

    private async Task ExecuteWorkflow()
    {
        if (Workflow is null)
            return;

        try
        {
            Log($"Executing workflow: {Workflow.Name}");

            Result = await WorkflowService.ExecuteAsync(Workflow);

            Log("═══════════════════════════════");
            Log("WORKFLOW COMPLETED");
            Log("═══════════════════════════════");

            if (Result?.Variables is not null &&
                Result.Variables.Count > 0)
            {
                foreach (var variable in Result.Variables)
                {
                    Log($"OUTPUT: {variable.Key}");

                    var value = variable.Value?.ToString() ?? "(null)";

                    if (value.Length > 2000)
                    {
                        value = value[..2000] + "...";
                    }

                    Log(value);

                    Log("───────────────────────────────");
                }
            }
            else
            {
                Log("No output variables returned.");
            }
        }
        catch (Exception ex)
        {
            Log($"ERROR: {ex.Message}");
        }
    }
    private void ValidateWorkflow()
    {
        if (Workflow is null) return;

        var errors = Validator.Validate(Workflow);

        if (errors.Count == 0)
        {
            Log("Validation passed.");
            return;
        }

        foreach (var error in errors)
        {
            Log(error);
        }
    }

    private void SelectStep(WorkflowStep step)
    {
        SelectedStep = step;
    }

    private void AddPlugin(string type)
    {
        if (Workflow is null)
            return;

        var step = new WorkflowStep
        {
            Name = $"{type} step",
            Type = type,
            Enabled = true,
            Order = Workflow.DataSources.Count + 1,
            Output = $"{type}Output"
        };

        switch (type.ToLowerInvariant())
        {
            case "ai":
                step.Settings["provider"] = "AzureOpenAI";
                step.Settings["model"] = "gpt-5";
                step.Settings["prompt"] = "Enter your prompt here...";
                break;

            case "http":
                step.Settings["method"] = "GET";
                step.Settings["url"] = "";
                break;

            case "scrape":
                step.Settings["url"] = "";
                break;

            case "sql":
                step.Settings["connection"] = "";
                step.Settings["query"] = "";
                break;

            case "email":
                step.Settings["to"] = "";
                step.Settings["subject"] = "";
                step.Settings["body"] = "";
                break;

            case "sharepoint":
                step.Settings["siteUrl"] = "";
                step.Settings["listName"] = "";
                step.Settings["operation"] = "read";
                break;

            case "file":
                step.Settings["path"] = "";
                step.Settings["fileName"] = "Report.html";
                break;
        }

        Workflow.DataSources.Add(step);

        SelectedStep = step;

        Log($"{type} step added.");

        StateHasChanged();
    }

    private void ShowDeleteConfirmation()
    {
        Log("Delete button clicked");
        ShowDeleteDialog = true;
    }

    private void CancelDelete()
    {
        ShowDeleteDialog = false;
        StateHasChanged();
    }

    private void DeleteConfirmed()
    {
        if (Workflow is null || SelectedStep is null)
            return;

        var stepName = SelectedStep.Name;

        Workflow.DataSources.RemoveAll(s => s == SelectedStep);

        // ✅ reset selection
        SelectedStep = null;

        // ✅ re-order steps (very important)
        int order = 1;
        foreach (var step in Workflow.DataSources.OrderBy(x => x.Order))
        {
            step.Order = order++;
        }

        ShowDeleteDialog = false;

        Log($"Step '{stepName}' removed.");

        StateHasChanged();
    }

    private void Log(string message)
    {
        Logs.Add(
            $"[{DateTime.Now:HH:mm:ss}] {message}");

        if (Logs.Count > 500)
            Logs.RemoveAt(0);

        StateHasChanged();
    }

    private string GetSetting(string key)
    {
        if (SelectedStep is null)
            return string.Empty;

        if (SelectedStep.Settings.TryGetValue(
            key,
            out var value))
        {
            return value?.ToString()
                ?? string.Empty;
        }

        return string.Empty;
    }

    private void SetSetting(
        string key,
        string? value)
    {
        if (SelectedStep is null)
            return;

        SelectedStep.Settings[key] = value;
    }

    private void SetUrl(ChangeEventArgs e)
        => SetSetting("url", e.Value?.ToString());

    private void SetMethod(ChangeEventArgs e)
        => SetSetting("method", e.Value?.ToString());

    private void SetPath(ChangeEventArgs e)
        => SetSetting("path", e.Value?.ToString());

    private void SetConnection(ChangeEventArgs e)
        => SetSetting("connection", e.Value?.ToString());

    private void SetQuery(ChangeEventArgs e)
        => SetSetting("query", e.Value?.ToString());

    private void SetEmailTo(ChangeEventArgs e)
        => SetSetting("to", e.Value?.ToString());

    private void SetEmailSubject(ChangeEventArgs e)
        => SetSetting("subject", e.Value?.ToString());

    private void SetEmailBody(ChangeEventArgs e)
        => SetSetting("body", e.Value?.ToString());

    private void SetSiteUrl(ChangeEventArgs e)
        => SetSetting("siteUrl", e.Value?.ToString());

    private void SetListName(ChangeEventArgs e)
        => SetSetting("listName", e.Value?.ToString());

    private async Task RefreshWorkflows()
    {
        WorkflowFiles = await WorkflowService.GetWorkflowsAsync();

        Log("Workflow list refreshed.");
    }

    private void ClearLogs()
    {
        Logs.Clear();

        StateHasChanged();
    }

