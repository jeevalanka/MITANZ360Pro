</style>

@code
{
    private List<string> WorkflowFiles =
        [];

    private string SelectedWorkflow =
        string.Empty;

    private string Response =
        string.Empty;

    private string ErrorMessage =
        string.Empty;

    private string GeneratedAt =
        string.Empty;

    private bool IsLoading;

    private AiOutputMode SelectedOutputMode { get; set; } =
        AiOutputMode.Html;

    protected override void OnInitialized()
    {
        try
        {
            var folder =
                Path.Combine(
                    Environment.WebRootPath,
                    "AI-Eng");

            if (!Directory.Exists(folder))
            {
                Directory.CreateDirectory(folder);
            }

            WorkflowFiles =
                Directory
                    .GetFiles(folder, "*.json")
                    .Select(Path.GetFileNameWithoutExtension)
                    .OrderBy(x => x)
                    .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to load workflow files.");

            ErrorMessage =
                ex.Message;
        }
    }

    private async Task ExecuteWorkflowAsync()
    {
        try
        {
            ErrorMessage = string.Empty;

            Response = string.Empty;

            IsLoading = true;

            var workflowPath =
                Path.Combine(
                    Environment.WebRootPath,
                    "AI-Eng",
                    $"{SelectedWorkflow}.json");

            if (!File.Exists(workflowPath))
            {
                ErrorMessage =
                    "Workflow file not found.";

                return;
            }

            var rawJson =
                await File.ReadAllTextAsync(
                    workflowPath);

            Logger.LogInformation(
                "Executing workflow: {Workflow}",
                SelectedWorkflow);

            var request =
                new AiWorkflowRequest
                {
                    TaskType =
                        AiTaskType.Chat,

                    Prompt =
                        rawJson,

                    OutputMode =
                        SelectedOutputMode,

                    StrictJsonResponse =
                        SelectedOutputMode ==
                        AiOutputMode.JsonOnly,

                    SystemPrompt =
                        """
                        You are an enterprise AI workflow execution engine.

                        The provided JSON contains:
                        - instructions
                        - orchestration
                        - execution rules
                        - output requirements
                        - workflow metadata

                        Read the JSON carefully.

                        Execute the workflow exactly as instructed.

                        Return output according to the workflow definition.
                        """,

                    CorrelationId =
                        Guid.NewGuid().ToString()
                };

            var result =
                await WorkflowEngine.ExecuteAsync(
                    request);

            if (!result.Success)
            {
                ErrorMessage =
                    string.Join(
                        System.Environment.NewLine,
                        result.Errors);

                return;
            }

            Response =
                ExtractContent(
                    result.RawResponse);

            GeneratedAt =
                DateTime.Now.ToString(
                    "dd MMM yyyy hh:mm tt");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Workflow execution failed.");

            ErrorMessage =
                ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }


private static string ExtractContent(
    string rawResponse)
    {
        try
        {
            // STEP 1
            // Extract AI content

            using var document =
                JsonDocument.Parse(rawResponse);

            var content =
                document.RootElement
                    .GetProperty("choices")[0]
                    .GetProperty("message")
                    .GetProperty("content")
                    .GetString();

            if (string.IsNullOrWhiteSpace(content))
            {
                return rawResponse;
            }

            // STEP 2
            // Remove markdown wrappers

            content =
                content
                    .Replace("```json", "")
                    .Replace("```", "")
                    .Trim();

            // STEP 3
            // Try parse JSON

            using var jsonDocument =
                JsonDocument.Parse(content);

            var root =
                jsonDocument.RootElement;

            // STEP 4
            // Build Enterprise HTML

            var html =
                new System.Text.StringBuilder();

            html.Append(
            """
            <div class='container-fluid'>

                <div class='row g-4'>
            """);

            // SUMMARY

            if (root.TryGetProperty(
                "summary",
                out var summary))
            {
                html.Append(
                    $"""
                <div class='col-12'>

                    <div class='card glass-card-inner'>

                        <div class='card-body'>

                            <h3 class='mb-3'>
                                Executive Summary
                            </h3>

                            <p>
                                {summary.GetString()}
                            </p>

                        </div>

                    </div>

                </div>
                """);
            }

            // CURRENCY ANALYSIS

            if (root.TryGetProperty(
                "currencyAnalysis",
                out var currencies))
            {
                foreach (var item in
                    currencies.EnumerateArray())
                {
                    html.Append(
                        $"""
                    <div class='col-md-6'>

                        <div class='card glass-card-inner h-100'>

                            <div class='card-body'>

                                <h4 class='mb-3 text-primary'>
                                    {item.GetProperty("currency").GetString()}
                                </h4>

                                <table class='table table-borderless'>

                                    <tr>
                                        <td>
                                            Best Buying
                                        </td>

                                        <td>
                                            <strong>
                                                {item.GetProperty("bestBuyingBank").GetString()}
                                            </strong>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            Best Selling
                                        </td>

                                        <td>
                                            <strong>
                                                {item.GetProperty("bestSellingBank").GetString()}
                                            </strong>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            Highest Buying
                                        </td>

                                        <td>
                                            {item.GetProperty("highestBuyingRate").GetDecimal()}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            Lowest Selling
                                        </td>

                                        <td>
                                            {item.GetProperty("lowestSellingRate").GetDecimal()}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            Variance
                                        </td>

                                        <td>
                                            {item.GetProperty("variance").GetDecimal()}
                                        </td>
                                    </tr>

                                </table>

                                <div class='alert alert-primary mt-3'>

                                    {item.GetProperty("insight").GetString()}

                                </div>

                            </div>

                        </div>

                    </div>
                    """);
                }
            }

            // MARKET INSIGHTS

            if (root.TryGetProperty(
                "marketInsights",
                out var marketInsights))
            {
                html.Append(
                    $"""
                <div class='col-12'>

                    <div class='card glass-card-inner'>

                        <div class='card-body'>

                            <h3 class='mb-3'>
                                Market Insights
                            </h3>

                            <p>
                                {marketInsights.GetString()}
                            </p>

                        </div>

                    </div>

                </div>
                """);
            }

            // RISK INDICATORS

            if (root.TryGetProperty(
                "riskIndicators",
                out var risks))
            {
                html.Append(
                    $"""
                <div class='col-12'>

                    <div class='card glass-card-inner'>

                        <div class='card-body'>

                            <h3 class='mb-3 text-danger'>
                                Risk Indicators
                            </h3>

                            <p>
                                {risks.GetString()}
                            </p>

                        </div>

                    </div>

                </div>
                """);
            }

            // RECOMMENDATIONS

            if (root.TryGetProperty(
                "recommendations",
                out var recommendations))
            {
                html.Append(
                    $"""
                <div class='col-12'>

                    <div class='card glass-card-inner'>

                        <div class='card-body'>

                            <h3 class='mb-3 text-success'>
                                Recommendations
                            </h3>

                            <p>
                                {recommendations.GetString()}
                            </p>

                        </div>

                    </div>

                </div>
                """);
            }

            html.Append(
            """
                </div>

            </div>
            """);

            return html.ToString();
        }
        catch
        {
            return rawResponse;
        }
    }
}