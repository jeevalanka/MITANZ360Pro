@page "/entities"
@layout MainLayout
@attribute [Authorize(Roles = "Admin,SysAdmin")]
@implements IDisposable

@using MITANZ360Pro.Web.Modules.Entities
@using Radzen
@using Radzen.Blazor

@inject IEntityService EntityService
@inject IEntityTemplateService TemplateService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Entities</PageTitle>

<div class="ms-entities">
    <div class="ms-entities-header">
        <div>
            <h1 class="ms-entities-title">Entities</h1>
            <p class="ms-entities-subtitle">Manage metadata-driven entity records.</p>
        </div>

        <div class="ms-entities-toolbar" role="toolbar" aria-label="Entity actions">
            <RadzenButton Text="New"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@BeginCreate"
                          aria-label="Create new entity" />
            <RadzenButton Text="Refresh"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Click="@RefreshGridAsync"
                          aria-label="Refresh entity list" />
            <RadzenButton Text="Export"
                          Icon="download"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Click="@ExportCurrentPage"
                          Disabled="@(!PagedItems.Any())"
                          aria-label="Export current page" />
        </div>
    </div>

    <div class="ms-entities-filters" role="search" aria-label="Entity filters">
        <RadzenTextBox Value="@Filter.SearchText"
                       ValueChanged="@OnSearchTextChanged"
                       Placeholder="Search title, ID, type, or metadata"
                       Style="width:100%"
                       aria-label="Search entities" />

        <RadzenDropDown TValue="string"
                        Data="@EntityTypeOptions"
                        TextProperty="DisplayName"
                        ValueProperty="EntityType"
                        @bind-Value="Filter.EntityType"
                        Placeholder="All types"
                        AllowClear="true"
                        Change="@(_ => ReloadGrid())"
                        Style="width:100%"
                        aria-label="Filter by entity type" />

        <RadzenDropDown TValue="string"
                        Data="@StatusOptions"
                        @bind-Value="Filter.Status"
                        Placeholder="All statuses"
                        AllowClear="true"
                        Change="@(_ => ReloadGrid())"
                        Style="width:100%"
                        aria-label="Filter by status" />

        <RadzenDropDown TValue="bool?"
                        Data="@ActiveOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        @bind-Value="Filter.IsActive"
                        Placeholder="All active states"
                        AllowClear="true"
                        Change="@(_ => ReloadGrid())"
                        Style="width:100%"
                        aria-label="Filter by active state" />

        <RadzenDatePicker TValue="DateTime?"
                          @bind-Value="Filter.CreatedFrom"
                          Placeholder="Created from"
                          Change="@(_ => ReloadGrid())"
                          Style="width:100%"
                          aria-label="Created from date" />

        <RadzenDatePicker TValue="DateTime?"
                          @bind-Value="Filter.CreatedTo"
                          Placeholder="Created to"
                          Change="@(_ => ReloadGrid())"
                          Style="width:100%"
                          aria-label="Created to date" />
    </div>

    @if (IsGridLoading && !HasLoadedOnce)
    {
        <div class="ms-entities-loading" role="status" aria-live="polite">
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width:100%" />
            <span>Loading entities...</span>
        </div>
    }

    <div class="ms-entities-grid-wrap @(IsGridLoading ? "is-loading" : null)">
        <RadzenDataGrid @ref="Grid"
                        TItem="Entity"
                        Data="@PagedItems"
                        Count="@TotalCount"
                        LoadData="@LoadGridData"
                        IsLoading="@IsGridLoading"
                        AllowPaging="true"
                        PageSize="25"
                        AllowSorting="false"
                        Responsive="true"
                        Density="Density.Compact"
                        class="ms-entities-grid"
                        aria-label="Entity list">
            <Columns>
                <RadzenDataGridColumn Property="Title" Title="Title" />
                <RadzenDataGridColumn Property="EntityId" Title="Entity ID" Width="140px" />
                <RadzenDataGridColumn Property="EntityType" Title="Type" Width="120px" />
                <RadzenDataGridColumn Property="Status" Title="Status" Width="110px">
                    <Template Context="item">
                        <span class="ms-status ms-status-@item.Status.ToLowerInvariant()">@item.Status</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Active" Width="90px">
                    <Template Context="item">
                        @(item.IsActive ? "Yes" : "No")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="Created" Title="Created" Width="160px" FormatString="{0:g}" />
                <RadzenDataGridColumn Title="Actions" Width="100px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      title="Edit"
                                      Click="@(() => BeginEdit(item))"
                                      aria-label="@($"Edit {item.EntityId}")" />
                        <RadzenButton Icon="visibility"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      title="View"
                                      Click="@(() => OpenDrawer(item))"
                                      aria-label="@($"View {item.EntityId}")" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (HasLoadedOnce && !IsGridLoading && TotalCount == 0)
        {
            <div class="ms-entities-empty" role="status">
                <p>No entities found.</p>
                <RadzenButton Text="Create First Entity"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@BeginCreate"
                              aria-label="Create first entity" />
            </div>
        }
    </div>


    @if (ShowEditor)
    {
        <div class="entity-editor-overlay" role="dialog" aria-modal="true" aria-labelledby="entity-editor-title">
            <RadzenCard class="entity-editor">
                <div class="entity-editor-header">
                    <h3 id="entity-editor-title">@(IsCreateMode ? "Create Entity" : "Edit Entity")</h3>
                    <RadzenButton Icon="close"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@CloseEditor"
                                  aria-label="Close editor" />
                </div>

                @if (IsSaving)
                {
                    <div class="entity-loading" role="status" aria-live="polite">
                        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width:100%" />
                        <span>@(IsCreateMode ? "Creating entity..." : "Saving entity...")</span>
                    </div>
                }

                <fieldset class="entity-section" disabled="@IsSaving">
                    <legend>Basic Information</legend>

                    <div class="form-row">
                        <label for="entity-id">
                            Entity ID <span class="required-indicator" aria-hidden="true">*</span>
                        </label>
                        <div class="entity-id-row">
                            <RadzenTextBox id="entity-id"
                                           Value="@EditorModel.EntityId"
                                           ValueChanged="@OnEntityIdChanged"
                                           Style="width:100%"
                                           Disabled="@(!IsCreateMode)"
                                           aria-required="true"
                                           aria-describedby="entity-id-status" />
                            @if (IsCreateMode)
                            {
                                <RadzenButton Text="Generate"
                                              Icon="autorenew"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@GenerateEntityIdAsync"
                                              aria-label="Generate entity ID" />
                            }
                        </div>
                        <div id="entity-id-status" class="entity-id-status" aria-live="polite">
                            @if (IdAvailability == EntityIdAvailability.Checking)
                            {
                                <span>Checking availability...</span>
                            }
                            else if (IdAvailability == EntityIdAvailability.Available)
                            {
                                <span class="status-ok">Available</span>
                            }
                            else if (IdAvailability == EntityIdAvailability.Duplicate)
                            {
                                <span class="status-warn">Already exists</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <label for="entity-title">
                            Title <span class="required-indicator" aria-hidden="true">*</span>
                        </label>
                        <RadzenTextBox id="entity-title"
                                       @bind-Value="EditorModel.Title"
                                       Style="width:100%"
                                       Change="@(_ => MarkDirty())"
                                       aria-required="true" />
                    </div>

                    <div class="form-row">
                        <label for="entity-type">
                            Entity Type <span class="required-indicator" aria-hidden="true">*</span>
                        </label>
                        <RadzenDropDown id="entity-type"
                                        TValue="string"
                                        Data="@EntityTypeOptions"
                                        TextProperty="DisplayName"
                                        ValueProperty="EntityType"
                                        @bind-Value="EditorModel.EntityType"
                                        Change="@OnEntityTypeChanged"
                                        Style="width:100%"
                                        aria-required="true" />
                    </div>

                    <div class="form-row">
                        <label for="entity-status">Status</label>
                        <RadzenDropDown id="entity-status"
                                        TValue="string"
                                        Data="@StatusOptions"
                                        @bind-Value="EditorModel.Status"
                                        Style="width:100%" />
                    </div>

                    <div class="form-row">
                        <RadzenCheckBox @bind-Value="EditorModel.IsActive" Name="entity-active" />
                        <label for="entity-active">Active</label>
                    </div>
                </fieldset>

                <fieldset class="entity-section" disabled="@IsSaving">
                    <legend>Metadata</legend>

                    @if (IsTemplateLoading)
                    {
                        <div class="entity-loading" role="status" aria-live="polite">
                            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width:100%" />
                            <span>Loading template...</span>
                        </div>
                    }
                    else
                    {
                        <DynamicMetadataRenderer Template="@SelectedTemplate"
                                                 Metadata="@EditorModel.Metadata"
                                                 MetadataChanged="@OnMetadataChanged" />
                    }
                </fieldset>

                @if (!IsCreateMode)
                {
                    <fieldset class="entity-section" disabled="true">
                        <legend>Audit Information</legend>
                        <div class="audit-grid">
                            <div><strong>Created:</strong> @EditorModel.Created?.ToString("g")</div>
                            <div><strong>Created By:</strong> @EditorModel.CreatedBy</div>
                            <div><strong>Modified:</strong> @EditorModel.Modified?.ToString("g")</div>
                            <div><strong>Modified By:</strong> @EditorModel.ModifiedBy</div>
                        </div>
                    </fieldset>
                }

                <div class="entity-editor-actions">
                    <RadzenButton Text="Cancel"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@CloseEditor"
                                  aria-label="Cancel editing" />
                    <RadzenButton Text="@(IsCreateMode ? "Create" : "Save")"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@SaveAsync"
                                  Disabled="@IsSaving"
                                  aria-label="@(IsCreateMode ? "Create entity" : "Save entity")" />
                </div>
            </RadzenCard>
        </div>
    }

    @if (DrawerEntity != null)
    {
        <aside class="entity-drawer" role="complementary" aria-label="Entity details">
            <div class="entity-drawer-header">
                <h3>@DrawerEntity.EntityId</h3>
                <RadzenButton Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@CloseDrawer"
                              aria-label="Close details drawer" />
            </div>
            <p><strong>Title:</strong> @DrawerEntity.Title</p>
            <p><strong>Type:</strong> @DrawerEntity.EntityType</p>
            <p><strong>Status:</strong> @DrawerEntity.Status</p>
            <p><strong>Active:</strong> @(DrawerEntity.IsActive ? "Yes" : "No")</p>

            @if (DrawerEntity.Metadata.Any())
            {
                <h4>Metadata</h4>
                <ul>
                    @foreach (var entry in DrawerEntity.Metadata)
                    {
                        <li><strong>@entry.Key:</strong> @entry.Value</li>
                    }
                </ul>
            }
        </aside>
    }
</div>

@code {
    private enum EntityIdAvailability
    {
        None,
        Checking,
        Available,
        Duplicate
    }

    private RadzenDataGrid<Entity>? Grid;
    private List<Entity> PagedItems = [];
    private int TotalCount;
    private bool IsGridLoading;
    private bool HasLoadedOnce;
    private bool IsSaving;
    private bool IsTemplateLoading;
    private bool ShowEditor;
    private bool IsCreateMode;
    private bool IsDirty;

    private EntityFilter Filter = new()
    {
        Status = EntityStatuses.Active,
        IsActive = true
    };
    private Entity EditorModel = new();
    private Entity? DrawerEntity;
    private EntityTemplate? SelectedTemplate;
    private List<EntityTemplate> EntityTypeOptions = [];

    private EntityIdAvailability IdAvailability = EntityIdAvailability.None;

    private readonly string[] StatusOptions = [EntityStatuses.Draft, EntityStatuses.Active, EntityStatuses.Archived];

    private readonly List<ActiveOption> ActiveOptions =
    [
        new("Active", true),
        new("Inactive", false)
    ];

    private CancellationTokenSource? _entityIdDebounceCts;
    private CancellationTokenSource? _searchDebounceCts;

    protected override async Task OnInitializedAsync()
    {
        EntityTypeOptions = (await TemplateService.GetTemplatesAsync()).ToList();

        // Load immediately — do not wait for the grid LoadData callback
        // (empty-state used to hide the grid and LoadData never fired).
        await LoadEntitiesAsync(pageNumber: 1, pageSize: 25);
    }

    private async Task LoadGridData(LoadDataArgs args)
    {
        var pageNumber = (args.Skip ?? 0) / (args.Top ?? 25) + 1;
        var pageSize = args.Top ?? 25;
        await LoadEntitiesAsync(pageNumber, pageSize);
    }

    private async Task LoadEntitiesAsync(int pageNumber, int pageSize)
    {
        IsGridLoading = true;
        StateHasChanged();

        try
        {
            Filter.PageNumber = pageNumber;
            Filter.PageSize = pageSize;

            var result = await EntityService.GetPagedAsync(Filter);
            PagedItems = result.Items.ToList();
            TotalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            PagedItems = [];
            TotalCount = 0;
            NotificationService.Notify(NotificationSeverity.Error, "Load Failed", ex.Message);
        }
        finally
        {
            HasLoadedOnce = true;
            IsGridLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshGridAsync()
    {
        if (Grid != null)
        {
            await Grid.Reload();
            return;
        }

        await LoadEntitiesAsync(Filter.PageNumber <= 0 ? 1 : Filter.PageNumber, Filter.PageSize <= 0 ? 25 : Filter.PageSize);
    }

    private Task ReloadGrid()
    {
        Filter.PageNumber = 1;
        return RefreshGridAsync();
    }

    private void OnSearchTextChanged(string value)
    {
        Filter.SearchText = value;
        _searchDebounceCts?.Cancel();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;
        _ = DebounceSearchAsync(token);
    }

    private void OnEntityIdChanged(string value)
    {
        EditorModel.EntityId = value;
        MarkDirty();
        _entityIdDebounceCts?.Cancel();
        _entityIdDebounceCts = new CancellationTokenSource();
        var token = _entityIdDebounceCts.Token;
        _ = DebounceEntityIdCheckAsync(token);
    }

    private async Task DebounceSearchAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(500, token);
            Filter.PageNumber = 1;
            await InvokeAsync(RefreshGridAsync);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void BeginCreate()
    {
        EditorModel = new Entity
        {
            Status = EntityStatuses.Draft,
            IsActive = true,
            Metadata = new Dictionary<string, object?>()
        };

        IsCreateMode = true;
        ShowEditor = true;
        IsDirty = false;
        IdAvailability = EntityIdAvailability.None;
        SelectedTemplate = null;
    }

    private async Task BeginEdit(Entity entity)
    {
        Entity? loaded = null;

        if (entity.Id > 0)
        {
            loaded = await EntityService.GetByIdAsync(entity.Id);
        }

        // Fallback: resolve by business EntityId when list item Id was lost (legacy mapper bug).
        if (loaded == null && !string.IsNullOrWhiteSpace(entity.EntityId))
        {
            loaded = await EntityService.GetByEntityIdAsync(entity.EntityId);
        }

        EditorModel = CloneEntity(loaded ?? entity);

        if (EditorModel.Id <= 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Edit Failed",
                "Could not resolve the SharePoint list item Id for this entity. Refresh the grid and try again.");
            return;
        }

        IsCreateMode = false;
        ShowEditor = true;
        IsDirty = false;
        IdAvailability = EntityIdAvailability.None;

        await LoadTemplateAsync(EditorModel.EntityType);
    }

    private async Task CloseEditor()
    {
        if (IsDirty)
        {
            var confirmed = await DialogService.Confirm(
                "You have unsaved changes. Leave page?",
                "Unsaved Changes",
                new ConfirmOptions { OkButtonText = "Leave", CancelButtonText = "Stay" });

            if (confirmed != true)
            {
                return;
            }
        }

        ShowEditor = false;
        IsDirty = false;
    }

    private async Task SaveAsync()
    {
        if (IsCreateMode &&
            IdAvailability == EntityIdAvailability.Duplicate)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Validation",
                $"Entity ID '{EditorModel.EntityId}' already exists.");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        try
        {
            if (IsCreateMode)
            {
                var result = await EntityService.CreateAsync(EditorModel);

                if (!result.IsSuccess)
                {
                    NotificationService.Notify(
                        NotificationSeverity.Warning,
                        "Validation",
                        result.ErrorMessage);
                    return;
                }

                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Success",
                    $"Entity created successfully {result.Data!.Id}.");

                ShowEditor = false;
                IsDirty = false;
                await RefreshGridAsync();
            }
            else
            {
                // Edit must never create. Resolve Id by EntityId if needed, then update only.
                if (EditorModel.Id <= 0 && !string.IsNullOrWhiteSpace(EditorModel.EntityId))
                {
                    var existing = await EntityService.GetByEntityIdAsync(EditorModel.EntityId);
                    if (existing != null)
                    {
                        EditorModel.Id = existing.Id;
                    }
                }

                if (EditorModel.Id <= 0)
                {
                    NotificationService.Notify(
                        NotificationSeverity.Error,
                        "Save Failed",
                        "Cannot update: missing SharePoint item Id. Close the editor, refresh, and open Edit again.");
                    return;
                }

                var result = await EntityService.UpdateAsync(EditorModel);

                if (!result.IsSuccess)
                {
                    NotificationService.Notify(
                        NotificationSeverity.Warning,
                        "Validation",
                        result.ErrorMessage);
                    return;
                }

                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Success",
                    "Entity updated successfully.");

                ShowEditor = false;
                IsDirty = false;
                await RefreshGridAsync();
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ArchiveEntity(Entity entity)
    {
        var confirmed = await DialogService.Confirm(
            $"Archive entity {entity.EntityId}?",
            "Archive Entity",
            new ConfirmOptions { OkButtonText = "Archive", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        IsGridLoading = true;
        StateHasChanged();

        try
        {
            var result = await EntityService.ArchiveAsync(entity.Id);

            if (!result.IsSuccess)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Archive Failed", result.ErrorMessage);
                return;
            }

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Success",
                "Entity archived successfully.");

            await RefreshGridAsync();
        }
        finally
        {
            IsGridLoading = false;
        }
    }

    private async Task GenerateEntityIdAsync()
    {
        EditorModel.EntityId = await EntityService.GenerateEntityIdAsync();
        MarkDirty();
        await CheckEntityIdAsync();
    }

    private async Task DebounceEntityIdCheckAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(500, token);
            await CheckEntityIdAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task CheckEntityIdAsync()
    {
        if (!IsCreateMode || string.IsNullOrWhiteSpace(EditorModel.EntityId))
        {
            IdAvailability = EntityIdAvailability.None;
            return;
        }

        IdAvailability = EntityIdAvailability.Checking;
        await InvokeAsync(StateHasChanged);

        var exists = await EntityService.EntityIdExistsAsync(EditorModel.EntityId);
        IdAvailability = exists
            ? EntityIdAvailability.Duplicate
            : EntityIdAvailability.Available;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnEntityTypeChanged(object? value)
    {
        MarkDirty();
        await LoadTemplateAsync(value?.ToString() ?? EditorModel.EntityType);
    }

    private async Task LoadTemplateAsync(string? entityType)
    {
        if (string.IsNullOrWhiteSpace(entityType))
        {
            SelectedTemplate = null;
            return;
        }

        IsTemplateLoading = true;
        StateHasChanged();

        try
        {
            SelectedTemplate = await TemplateService.GetTemplateAsync(entityType);

            if (SelectedTemplate != null)
            {
                foreach (var field in SelectedTemplate.Fields)
                {
                    EditorModel.Metadata.TryAdd(field.Name, null);
                }
            }
        }
        finally
        {
            IsTemplateLoading = false;
        }
    }

    private Task OnMetadataChanged(Dictionary<string, object?> metadata)
    {
        EditorModel.Metadata = metadata;
        MarkDirty();
        return Task.CompletedTask;
    }

    private void MarkDirty()
    {
        IsDirty = true;
    }

    private static Entity CloneEntity(Entity source)
    {
        return new Entity
        {
            Id = source.Id,
            Title = source.Title,
            EntityId = source.EntityId,
            EntityType = source.EntityType,
            Status = source.Status,
            IsActive = source.IsActive,
            Metadata = source.Metadata != null
                ? new Dictionary<string, object?>(source.Metadata)
                : new Dictionary<string, object?>(),
            Created = source.Created,
            Modified = source.Modified,
            CreatedBy = source.CreatedBy,
            ModifiedBy = source.ModifiedBy
        };
    }

    private void OpenDrawer(Entity entity)
    {
        DrawerEntity = entity;
    }

    private void CloseDrawer()
    {
        DrawerEntity = null;
    }

    private async Task ExportCurrentPage()
    {
        var csv = "EntityId,Title,EntityType,Status,IsActive,Created\n" +
                  string.Join("\n", PagedItems.Select(x =>
                      $"\"{x.EntityId}\",\"{x.Title}\",\"{x.EntityType}\",\"{x.Status}\",{x.IsActive},{x.Created:O}"));

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", csv);

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Export",
            "Current page copied to clipboard as CSV.");
    }

    public void Dispose()
    {
        _entityIdDebounceCts?.Cancel();
        _entityIdDebounceCts?.Dispose();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }

    private sealed record ActiveOption(string Text, bool Value);
}

<style>
    .ms-entities {
        --ms-brand: #0078d4;
        --ms-brand-hover: #106ebe;
        --ms-border: #edebe9;
        --ms-text: #323130;
        --ms-text-secondary: #605e5c;
        --ms-surface: #ffffff;
        --ms-surface-alt: #faf9f8;
        --ms-success: #107c10;
        --ms-warning: #797775;
        font-family: "Segoe UI", Segoe UI, system-ui, -apple-system, sans-serif;
        color: var(--ms-text);
        background: var(--ms-surface);
        border: 1px solid var(--ms-border);
        border-radius: 2px;
        padding: 1.25rem 1.5rem 1.5rem;
    }

    .ms-entities-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--ms-border);
    }

    .ms-entities-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--ms-text);
        letter-spacing: -0.01em;
    }

    .ms-entities-subtitle {
        margin: 0.25rem 0 0;
        color: var(--ms-text-secondary);
        font-size: 0.875rem;
    }

    .ms-entities-toolbar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .ms-entities-filters {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding: 0.75rem;
        background: var(--ms-surface-alt);
        border: 1px solid var(--ms-border);
        border-radius: 2px;
    }

    .ms-entities-loading {
        display: grid;
        gap: 0.5rem;
        margin: 1rem 0;
        color: var(--ms-text-secondary);
        font-size: 0.875rem;
    }

    .ms-entities-grid-wrap {
        position: relative;
        min-height: 160px;
    }

    .ms-entities-grid-wrap.is-loading {
        opacity: 0.7;
    }

    .ms-entities-empty {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--ms-text-secondary);
    }

