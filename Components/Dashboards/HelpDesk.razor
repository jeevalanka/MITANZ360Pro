@page "/help-desk"
@layout MainLayout_No_Left_RightPan

<PageTitle>AI HelpDesk</PageTitle>

<div class="helpdesk-page">

    <div class="hero-header">

        <div class="badge">
            🚀 Proposed AI-Powered Education HelpDesk
        </div>

        <h1>
            MITANZ360Pro
            <span>AI HelpDesk</span>
        </h1>

        <p>
            Intelligent. Automated. Always Here.
            Next-generation AI HelpDesk designed for education providers,
            students, academic staff, administration teams and support services.
        </p>

    </div>

    <div class="image-wrapper">

        <img src="/Images/AI HelpDesk.png"
             alt="MITANZ360Pro AI HelpDesk"
             class="helpdesk-image" />

    </div>

</div>

<style>

    .helpdesk-page {
        min-height: 100vh;
        background: radial-gradient(circle at top right, rgba(37,99,235,.12), transparent 35%), radial-gradient(circle at bottom left, rgba(124,58,237,.08), transparent 35%), linear-gradient(to bottom,#ffffff,#f8fafc);
        padding: 30px;
    }

    .hero-header {
        text-align: center;
        max-width: 1200px;
        margin: 0 auto 40px auto;
    }

    .badge {
        display: inline-block;
        background: #eef6ff;
        color: #2563eb;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 999px;
        border: 1px solid #dbeafe;
        margin-bottom: 20px;
    }

    .hero-header h1 {
        font-size: 4rem;
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 15px;
        line-height: 1.1;
    }

        .hero-header h1 span {
            display: block;
            background: linear-gradient( 90deg, #2563eb, #7c3aed );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-header p {
        max-width: 900px;
        margin: auto;
        color: #64748b;
        font-size: 1.15rem;
        line-height: 1.8;
    }

    .image-wrapper {
        width: 100%;
        max-width: 1800px;
        margin: auto;
        padding: 12px;
        border-radius: 40px;
        background: white;
        box-shadow: 0 10px 40px rgba(0,0,0,.05), 0 25px 80px rgba(0,0,0,.08);
        border: 1px solid #e2e8f0;
    }

    .helpdesk-image {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 32px;
    }

    @@media (max-width: 1200px) {

        .hero-header h1 {
            font-size: 3rem;
        }
    }

    @@media (max-width: 768px) {

        .helpdesk-page {
            padding: 15px;
        }

        .hero-header h1 {
            font-size: 2.2rem;
        }

        .hero-header p {
            font-size: 1rem;
        }

        .image-wrapper {
            border-radius: 24px;
        }

        .helpdesk-image {
            border-radius: 18px;
        }
    }

</style>