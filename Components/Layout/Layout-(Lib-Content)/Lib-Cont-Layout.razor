@namespace MITANZ360Pro.Web.Components.Layout
@inherits LayoutComponentBase

@using MITANZ360Pro.Web.Components.Layout.Layout__Lib_Content_
@using MITANZ360Pro.Web.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen
@using Radzen.Blazor
@using MITANZ360Pro.Web.Components.Layout
@using Microsoft.Extensions.Options
@using MITANZ360Pro.Web.Models

@inject IOptions<ApplicationSettings> AppSettings
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject HttpClient Http

<ErrorBoundary>
    <ChildContent>

        <RadzenDialog />
        <RadzenNotification />
        <RadzenTooltip />
        <RadzenContextMenu />

        <div class="page">

            <!-- SIDEBAR -->
            <div class="sidebar @(sidebarCollapsed ? "expanded" : "collapsed")">

                <NavLink href="/" class="logo-link">
                    <img src="images/Logo-v2.png" class="app-logo" />
                </NavLink>

                <LMS_Lib_Nav /> 

            </div>

            <!-- MAIN -->
            <main>

                <!-- TOP BAR -->
                <div class="top-row">

                    <div class="top-left">
                        <button class="burger-btn" @onclick="ToggleSidebar">
                            <i class="bi bi-list"></i>
                        </button>
                        @if (AppSettings?.Value.Name != null)
                        {
                            <span class="app-title" style="color:goldenrod">
                                @AppSettings.Value.Name
                            </span>
                        }
                    </div>

                    <div class="top-right">

                        <div class="user-info">
                            <AuthorizeView>
                                <NotAuthorized>
                                    <NavLink href="/xlogin" class="user-icon-link">
                                        <i class="bi bi-person-circle"></i>
                                    </NavLink>
                                </NotAuthorized>

                                <Authorized>
                                    <span class="user-icon-link">
                                        <i class="bi bi-person-circle"></i>
                                    </span>
                                </Authorized>
                            </AuthorizeView>

                            <div class="user-text-inline">
                                <span class="user-name">@(_displayName ?? "Guest")</span>
                                <span class="user-role">@(_rolesText ?? "")</span>
                            </div>
                        </div>

                        <div class="top-icons">
                            <button class="top-icon-btn">
                                <i class="bi bi-bell"></i>
                            </button>

                            <button class="top-icon-btn">
                                <i class="bi bi-gear"></i>
                            </button>

                            <AuthorizeView>
                                <Authorized>
                                    <button class="top-icon-btn" @onclick="Logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>

                    </div>

                </div>

                <!-- CONTENT + RIGHT PANEL -->
                <div class="content-wrapper">

                    <!-- MAIN CONTENT -->
                    <article class="content">
                        @Body
                    </article>

                </div>

            </main>
        </div>

    </ChildContent>

    <ErrorContent>
        <div class="alert alert-danger m-3">
            Something went wrong. Refresh the page.
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool sidebarCollapsed = true;

    private string? _displayName;
    private string _rolesText = "";

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName = user.Identity.Name;

            var roles = user.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();

            _rolesText = roles.Count > 0 ? string.Join(", ", roles) : "";
        }
        else
        {
            _displayName = "Guest";
            _rolesText = "";
        }
    }

    private async Task Logout()
    {
        Navigation.NavigateTo("xlogin", true);
    }
}

<style>

    /* =========================================
       GLOBAL
    ========================================= */
    * {
        box-sizing: border-box;
    }

    /* =========================================
       GLOBAL PAGE LAYOUT
    ========================================= */
    .page {
        display: flex;
        min-height: 100vh;
        overflow-x: hidden;
        overflow-y: auto;
        background: #0f1115;
    }

    /* =========================================
       SIDEBAR
    ========================================= */
    .sidebar {
        background: linear-gradient(180deg, #0b0b0b, #121212);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        box-shadow: 2px 0 10px rgba(0,0,0,0.5);
        overflow-x: hidden;
        overflow-y: auto;
        min-width: 100px;
        box-sizing: border-box;
    }

        /* EXPANDED */
        .sidebar.expanded {
            width: 700px;
        }

        /* COLLAPSED */
        .sidebar.collapsed {
            width: 100px;
        }

        /* FORCE CHILDREN */
        .sidebar > * {
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
        }

        /* SIDEBAR SCROLLBAR */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 4px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        @@media (max-width: 900px) {

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 1000;
            width: 300px;
            max-width: 90vw;
            transform: translateX(-100%);
        }

            .sidebar.expanded {
                transform: translateX(0);
            }

            .sidebar.collapsed {
                transform: translateX(-100%);
            }
    }

    /* =========================================
       LOGO
    ========================================= */
    .logo-link {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 12px;
        box-sizing: border-box;
    }

    .app-logo {
        width: 100%;
        max-width: 150px;
        object-fit: contain;
    }

    /* =========================================
       MAIN
    ========================================= */
    main {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 100vh;
        overflow-x: hidden;
        overflow-y: auto;
        min-width: 0;
        background: #f4f6f9;
    }

    /* =========================================
       TOP BAR
    ========================================= */
    .top-row {
        height: 60px;
        min-height: 60px;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(6px);
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 15px;
        border-bottom: 2px solid orange;
        box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        z-index: 100;
    }

    /* =========================================
       LEFT TOP
    ========================================= */
    .top-left {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .app-title {
        font-weight: bold;
        color: orange;
        font-size: 18px;
        white-space: nowrap;
    }

    /* =========================================
       BURGER BUTTON
    ========================================= */
    .burger-btn {
        background: transparent;
        border: none;
        color: orange;
        font-size: 22px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .burger-btn:hover {
            color: #fff;
            transform: scale(1.05);
        }

    /* =========================================
       RIGHT TOP
    ========================================= */
    .top-right {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }

    /* USER INFO */
    .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .user-text-inline {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
        min-width: 0;
    }

    .user-icon-link {
        color: orange;
        font-size: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-name {
        color: #4ea1ff;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-role {
        font-size: 11px;
        color: #aaa;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* =========================================
       ICONS
    ========================================= */
    .top-icons {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .top-icon-btn {
        background: transparent;
        border: none;
        color: orange;
        font-size: 18px;
        cursor: pointer;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .top-icon-btn:hover {
            background: rgba(255,165,0,0.15);
            color: #fff;
        }

    /* =========================================
       CONTENT WRAPPER
    ========================================= */
    .content-wrapper {
        display: flex;
        flex: 1;
        overflow-x: hidden;
        overflow-y: auto;
        min-width: 0;
    }

    /* =========================================
       MAIN CONTENT
    ========================================= */
    .content {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
        background: #f4f6f9;
        min-width: 0;
    }

        /* =========================================
       CONTENT SCROLLBAR
    ========================================= */
        .content::-webkit-scrollbar,
        .right-panel-container::-webkit-scrollbar {
            width: 6px;
        }

        .content::-webkit-scrollbar-thumb,
        .right-panel-container::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 4px;
        }

        .content::-webkit-scrollbar-track,
        .right-panel-container::-webkit-scrollbar-track {
            background: transparent;
        }

    /* =========================================
       RESPONSIVE
    ========================================= */
    @@media (max-width: 900px) {

        .right-panel-container {
            display: none;
        }

        .sidebar.expanded {
            width: 300px;
        }

        .top-row {
            height: 60px;
            min-height: 60px;
        }

        .app-title {
            font-size: 16px;
        }

        .top-right {
            gap: 10px;
        }
        @@media (max-width: 900px) {
            .top-row {
                height: auto;
                padding: 8px 10px;
            }
        }
    }

</style>