@* ============================================================
   DocumentViewer
   Renders a LibraryItem in-browser. Office documents are served
   through /api/documents/render/{id}, which converts them to PDF
   server-side (see SharePointService.DocumentViewer.cs) — the
   student never gets a direct download link to the original file.
   ============================================================ *@
@using MITANZ360Pro.Web.Services

<div class="doc-viewer">

    @if (!IsSupported)
    {
        <div class="doc-viewer-empty">
            <div class="doc-viewer-empty-icon">📄</div>
            <div>This file type can't be previewed in-browser.</div>
        </div>
    }
    else if (IsLoading)
    {
        <div class="doc-viewer-loading">
            <div class="doc-viewer-spinner" aria-hidden="true"></div>
            <div>@LoadingMessage</div>
        </div>
    }
    else if (HasError)
    {
        <div class="doc-viewer-empty doc-viewer-error">
            <div class="doc-viewer-empty-icon">⚠️</div>
            <div>@ErrorMessage</div>
        </div>
    }
    else if (ViewMode == "image")
    {
        <img class="doc-viewer-image"
             src="@RenderUrl"
             alt="@(Item?.Title ?? Item?.Name)"
             @onload="HandleLoaded"
             @onerror="HandleError" />
    }
    else
    {
        @* Covers PDF (native + converted), HTML, and text *@
        <iframe class="doc-viewer-frame"
                src="@FrameSrc"
                title="@(Item?.Title ?? Item?.Name)"
                @onload="HandleLoaded"></iframe>
    }

</div>

@code {
    /// <summary>The library item to preview. Only Name/Id/Title need to be set.</summary>
    [Parameter, EditorRequired] public LibraryItem? Item { get; set; }

    private bool IsLoading = true;
    private bool HasError;
    private string ErrorMessage = "";
    private string ViewMode = "";
    private bool IsSupported = true;
    private LibraryItem? _lastItem;

    private static readonly HashSet<string> ImageExtensions = new(StringComparer.OrdinalIgnoreCase)
        { ".png", ".jpg", ".jpeg", ".gif", ".webp" };

    private static readonly HashSet<string> ViewableExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".htm", ".html", ".txt",
        ".doc", ".docx", ".rtf", ".odt", ".xls", ".xlsx", ".ods",
        ".ppt", ".pptx", ".odp", ".vsd", ".vsdx"
    };

    private string LoadingMessage =>
        IsOfficeType ? "Preparing document for preview…" : "Loading…";

    private bool IsOfficeType
    {
        get
        {
            var ext = Path.GetExtension(Item?.Name ?? "");
            return !ImageExtensions.Contains(ext) &&
                   !string.Equals(ext, ".pdf", StringComparison.OrdinalIgnoreCase) &&
                   !string.Equals(ext, ".htm", StringComparison.OrdinalIgnoreCase) &&
                   !string.Equals(ext, ".html", StringComparison.OrdinalIgnoreCase) &&
                   !string.Equals(ext, ".txt", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string RenderUrl =>
        $"/api/documents/render/{Uri.EscapeDataString(Item!.Id)}";

    // #toolbar=0&navpanes=0 suppresses the built-in download/print controls
    // in Chromium's native PDF viewer. Firefox and Safari do not honor this
    // fragment, so this reduces — but cannot fully guarantee — download
    // access from the browser's own viewer chrome. There is no browser API
    // that fully disables it; the reliable control point is that we never
    // link to the original file for Office documents.
    private string FrameSrc =>
        ViewMode == "pdf" ? $"{RenderUrl}#toolbar=0&navpanes=0" : RenderUrl;

    protected override void OnParametersSet()
    {
        if (Item == null || Item.Id == _lastItem?.Id)
            return;

        _lastItem = Item;
        IsLoading = true;
        HasError = false;

        var ext = Path.GetExtension(Item.Name ?? "");

        IsSupported = ViewableExtensions.Contains(ext);

        ViewMode = ImageExtensions.Contains(ext)
            ? "image"
            : string.Equals(ext, ".pdf", StringComparison.OrdinalIgnoreCase)
                ? "pdf"
                : IsOfficeType
                    ? "pdf"   // Office docs are served pre-converted as PDF
                    : "raw";  // html / txt
    }

    private void HandleLoaded() => IsLoading = false;

    private void HandleError()
    {
        IsLoading = false;
        HasError = true;
        ErrorMessage = "This file couldn't be loaded. It may have been moved or you may not have access.";
    }
}

<style>
    .doc-viewer {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 480px;
        background: #f6f8fb;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e6ebf5;
    }

    .doc-viewer-frame,
    .doc-viewer-image {
        width: 100%;
        height: 100%;
        min-height: 480px;
        border: 0;
        display: block;
        background: #fff;
    }

    .doc-viewer-image {
        object-fit: contain;
    }

    .doc-viewer-loading,
    .doc-viewer-empty {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #6d7b99;
        font-size: .9rem;
        text-align: center;
        padding: 24px;
    }

    .doc-viewer-empty-icon {
        font-size: 2rem;
    }

    .doc-viewer-error {
        color: #b45309;
    }

    .doc-viewer-spinner {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 3px solid #dbe4f5;
        border-top-color: #2563eb;
        animation: doc-viewer-spin 0.8s linear infinite;
    }

    @@keyframes doc-viewer-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
