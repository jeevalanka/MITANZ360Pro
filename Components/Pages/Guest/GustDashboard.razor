@page "/guest-dashboard"
@layout MainLayout

@using Radzen
@using Radzen.Blazor
@inject NavigationManager Navigation

<PageTitle>Guest Dashboard</PageTitle>

<div class="guest-dashboard-page">

    <!-- BACKGROUND -->
    <div class="dashboard-overlay"></div>

    <!-- DASHBOARD CONTAINER -->
    <div class="dashboard-container">

        <!-- HEADER -->
        <div class="dashboard-header">

            <div class="header-left">

                <div class="dashboard-logo">
                    <i class="material-icons">dashboard</i>
                </div>

                <div>

                    <h1 class="dashboard-title">
                        Guest Dashboard
                    </h1>

                    <p class="dashboard-subtitle">
                        MITANZ360Pro Enterprise AI Education Framework
                    </p>

                </div>

            </div>

            <div class="guest-badge">
                Guest Access
            </div>

        </div>

        <!-- CARD GRID -->
        <div class="dashboard-grid">

            <!-- ABOUT -->
            <div class="glass-card card-blue">

                <div class="card-header">
                    <i class="material-icons">school</i>
                    <span>About MITANZ360Pro</span>
                </div>

                <p class="card-description">
                    Enterprise AI-driven education framework designed for
                    learning management, student engagement, automation,
                    SharePoint integration, and intelligent workflows.
                </p>

                <RadzenButton Text="Explore Courses"
                              Icon="arrow_forward"
                              ButtonStyle="ButtonStyle.Primary"
                              class="card-button"
                              Click="@(() => NavigateTo("/courses"))" />

            </div>

            <!-- MICROSOFT -->
            <div class="glass-card card-green">

                <div class="card-header">
                    <i class="material-icons">cloud</i>
                    <span>Microsoft Learning</span>
                </div>

                <p class="card-description">
                    Access Microsoft Azure, Power Platform,
                    AI engineering, and enterprise administration pathways.
                </p>

                <RadzenButton Text="View Learning Paths"
                              Icon="menu_book"
                              ButtonStyle="ButtonStyle.Success"
                              class="card-button"
                              Click="@(() => NavigateTo("/learning"))" />

            </div>

            <!-- AI -->
            <div class="glass-card card-purple">

                <div class="card-header">
                    <i class="material-icons">smart_toy</i>
                    <span>AI Services</span>
                </div>

                <p class="card-description">
                    Explore automation workflows, AI orchestration,
                    SharePoint intelligence, and enterprise AI operations.
                </p>

                <RadzenButton Text="Explore AI"
                              Icon="psychology"
                              ButtonStyle="ButtonStyle.Info"
                              class="card-button"
                              Click="@(() => NavigateTo("/ai-services"))" />

            </div>

            <!-- SUPPORT -->
            <div class="glass-card card-orange">

                <div class="card-header">
                    <i class="material-icons">support_agent</i>
                    <span>Student Support</span>
                </div>

                <p class="card-description">
                    Access onboarding guidance, student services,
                    and support resources for new learners.
                </p>

                <RadzenButton Text="Get Support"
                              Icon="help"
                              ButtonStyle="ButtonStyle.Warning"
                              class="card-button"
                              Click="@(() => NavigateTo("/support"))" />

            </div>

            <!-- CONTACT -->
            <div class="glass-card card-pink">

                <div class="card-header">
                    <i class="material-icons">mail</i>
                    <span>Contact MITANZ</span>
                </div>

                <p class="card-description">
                    Connect with MITANZ NZ Ltd for training,
                    consulting, and enterprise education solutions.
                </p>

                <div class="contact-info">

                    <div>
                        <strong>Email:</strong>
                        info@mitanz.com
                    </div>

                    <div>
                        <strong>Phone:</strong>
                        +64 220590223
                    </div>

                </div>

            </div>

            <!-- LOGIN -->
            <div class="glass-card card-cyan">

                <div class="card-header">
                    <i class="material-icons">login</i>
                    <span>Member Access</span>
                </div>

                <p class="card-description">
                    Already registered?
                    Login to access your personalized dashboard,
                    enrollments, workflows, and AI services.
                </p>

                <RadzenButton Text="Go To Login"
                              Icon="lock"
                              ButtonStyle="ButtonStyle.Secondary"
                              class="card-button"
                              Click="@GoToLogin" />

            </div>

        </div>

    </div>

</div>

@code {

    private void NavigateTo(string url)
    {
        try
        {
            Console.WriteLine($"Navigating To: {url}");

            Navigation.NavigateTo(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Navigation Error: {ex.Message}");
        }
    }

    private void GoToLogin()
    {
        try
        {
            Console.WriteLine("Redirecting To Login");

            Navigation.NavigateTo("/xlogin", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Login Redirect Error: {ex.Message}");
        }
    }
}

<style>

    /* =========================================
       PAGE
    ========================================= */

    .guest-dashboard-page {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        padding: 40px;
        background: linear-gradient(135deg, #eef4ff 0%, #dbeafe 100%);
    }

    /* =========================================
       OVERLAY
    ========================================= */

    .dashboard-overlay {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(8px);
    }

    /* =========================================
       CONTAINER
    ========================================= */

    .dashboard-container {
        position: relative;
        z-index: 10;
    }

    /* =========================================
       HEADER
    ========================================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .dashboard-logo {
        width: 90px;
        height: 90px;
        border-radius: 28px;
        background: linear-gradient(135deg, #2563eb, #38bdf8);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.8rem;
        box-shadow: 0 12px 35px rgba(37,99,235,0.25);
    }

    .dashboard-title {
        margin: 0;
        font-size: 3rem;
        font-weight: 800;
        color: #1e293b;
    }

    .dashboard-subtitle {
        margin-top: 8px;
        color: #64748b;
        font-size: 1.1rem;
    }

    /* =========================================
       GUEST BADGE
    ========================================= */

    .guest-badge {
        padding: 14px 22px;
        border-radius: 999px;
        background: rgba(59,130,246,0.15);
        color: #1d4ed8;
        font-weight: 700;
        font-size: 1rem;
    }

    /* =========================================
       GRID
    ========================================= */

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 28px;
    }

    /* =========================================
       GLASS CARD
    ========================================= */

    .glass-card {
        padding: 30px;
        border-radius: 30px;
        backdrop-filter: blur(18px);
        background: rgba(255,255,255,0.60);
        border: 1px solid rgba(255,255,255,0.30);
        box-shadow: 0 12px 35px rgba(0,0,0,0.10);
        transition: all 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
        }

    /* =========================================
       CARD COLORS
    ========================================= */

    .card-blue {
        background: linear-gradient(135deg, rgba(59,130,246,0.20), rgba(37,99,235,0.10));
    }

    .card-green {
        background: linear-gradient(135deg, rgba(16,185,129,0.20), rgba(5,150,105,0.10));
    }

    .card-purple {
        background: linear-gradient(135deg, rgba(168,85,247,0.20), rgba(147,51,234,0.10));
    }

    .card-orange {
        background: linear-gradient(135deg, rgba(249,115,22,0.20), rgba(234,88,12,0.10));
    }

    .card-pink {
        background: linear-gradient(135deg, rgba(236,72,153,0.20), rgba(190,24,93,0.10));
    }

    .card-cyan {
        background: linear-gradient(135deg, rgba(6,182,212,0.20), rgba(8,145,178,0.10));
    }

    /* =========================================
       CARD HEADER
    ========================================= */

    .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        font-size: 1.3rem;
        font-weight: 700;
        color: #1e293b;
    }

    /* =========================================
       DESCRIPTION
    ========================================= */

    .card-description {
        color: #475569;
        line-height: 1.7;
        margin-bottom: 24px;
        font-size: 1rem;
    }

    /* =========================================
       BUTTONS
    ========================================= */

    .card-button {
        width: 100%;
        height: 52px;
        border-radius: 18px !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
    }

    /* =========================================
       CONTACT INFO
    ========================================= */

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 14px;
        color: #1e293b;
        font-weight: 600;
    }

    /* =========================================
       MOBILE
    ========================================= */

    @@media (max-width: 768px) {

        .guest-dashboard-page {
            padding: 22px;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-left {
            flex-direction: column;
            text-align: center;
            width: 100%;
        }

        .dashboard-title {
            font-size: 2.2rem;
            text-align: center;
        }

        .dashboard-subtitle {
            text-align: center;
        }

        .guest-badge {
            width: 100%;
            text-align: center;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

</style>