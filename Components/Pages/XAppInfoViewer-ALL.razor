@page "/App-Info-viewer-all"
@layout MainLayout_No_Left_RightPan

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

<PageTitle>Enterprise Document Viewer</PageTitle>

<div class="doc-layout">

    <!-- SIDEBAR -->

    <aside class="sidebar-panel">

        <!-- HEADER -->

        <div class="sidebar-header">

            <div class="sidebar-logo">
                🏢
            </div>

            <div class="sidebar-info">
                <h2>Information Hub</h2>
                <p>Resources & Guides (App)</p>
            </div>

        </div>

        <!-- DOCUMENTS -->

        <div class="nav-section">

            <div class="nav-section-title">
                🧠 Knowledge, intelligence.
            </div>

            @if (Files.Any())
            {
                @foreach (var file in Files)
                {
                    <div class="document-item">

                        <button class="nav-item"
                                title="@file"
                                @onclick='async () => await LoadDocument(file)'>
                                <span class="file-text">
                                    @GetFileIcon(file)
                                    @Path.GetFileNameWithoutExtension(file)
                                </span>
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="empty-message">

                    No documents found.

                </div>
            }

        </div>

        <!-- UPLOAD -->

    </aside>

    <!-- CONTENT -->

    <main class="content-panel">

        <div class="document-container">

            <div style="background:#ffffff; color:#1f1f1f; padding:20px; border-radius:10px;">
                @((MarkupString)HtmlContent)
            </div>
        </div>

    </main>

</div>

<!-- DELETE CONFIRMATION -->
@if (!string.IsNullOrWhiteSpace(PendingDeleteFile))
{
    <div class="dialog-overlay">

        <div class="dialog-box">

            <h3>
                ⚠️ Delete Confirmation
            </h3>

            <p>

                Are you sure you want to delete:

                <strong>
                    @PendingDeleteFile
                </strong>

                ?

            </p>

            <div class="dialog-actions">

                <button class="cancel-button"
                        @onclick="CancelDelete">

                    Cancel

                </button>

                <button class="confirm-button"
                        @onclick="DeleteFile">

                    Delete

                </button>

            </div>

        </div>

    </div>
}

@code {

    private string HtmlContent = "";

    private string CurrentFile = "";

    private List<string> Files = new();

    private string? PendingDeleteFile;

    private readonly List<string> ProtectedFiles =
    [
        "about.html",
        "home.html",
        "index.html",
        "admin-guide.html"
    ];

    private readonly List<string> SupportedExtensions =
    [
        ".html",
        ".htm",
        ".pdf",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp",
        ".gif",
        ".mp4",
        ".webm",
        ".txt",
        ".docx",
        ".xlsx",
        ".json",
        ".pptx"
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
    }

    private async Task LoadFiles()
    {
        try
        {
            var filesPath = Path.Combine(
                Environment.WebRootPath,
                "Files");

            if (!Directory.Exists(filesPath))
            {
                Directory.CreateDirectory(filesPath);
            }

            Files = Directory
                .GetFiles(filesPath)
                .Where(file =>
                    SupportedExtensions.Contains(
                        Path.GetExtension(file),
                        StringComparer.OrdinalIgnoreCase))
                .Select(Path.GetFileName)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList()!;

            if (Files.Any())
            {
                await LoadDocument(Files.First()!);
            }
            else
            {
                HtmlContent =
                    "<div class='system-message'>No documents available.</div>";
            }
        }
        catch
        {
            HtmlContent =
                "<div class='system-message'>Failed to initialize document center.</div>";
        }
    }

    private async Task LoadDocument(string file)
    {
        try
        {
            CurrentFile = file;

            var extension =
                Path.GetExtension(file)
                    .ToLowerInvariant();

            var fileUrl =
                $"/Files/{file}";

            var filePath = Path.Combine(
                Environment.WebRootPath,
                "Files",
                file);

            switch (extension)
            {
                case ".html":
                case ".htm":

                    HtmlContent =
                        await File.ReadAllTextAsync(filePath);

                    break;

                case ".pdf":

                    HtmlContent = $@"
                    <iframe
                        src='{fileUrl}'
                        style='width:100%;
                               height:100%;
                               border:none;'>
                    </iframe>";

                    break;

                case ".png":
                case ".jpg":
                case ".jpeg":
                case ".webp":
                case ".gif":

                    HtmlContent = $@"
                    <div style='padding:20px;text-align:center;'>

                        <img src='{fileUrl}'
                             style='max-width:100%;
                                    border-radius:18px;' />

                    </div>";

                    break;

                case ".mp4":
                case ".webm":

                    HtmlContent = $@"
                    <div style='padding:20px;'>

                        <video controls style='width:100%;border-radius:18px;'>

                            <source src='{fileUrl}'>

                        </video>

                    </div>";

                    break;

                case ".txt":
                case ".json":

                    HtmlContent =
                        "<pre style='padding:20px;'>" +
                        await File.ReadAllTextAsync(filePath) +
                        "</pre>";

                    break;

                case ".docx":
                case ".xlsx":
                case ".csv":
                case ".pptx":

                    HtmlContent = $@"
                    <div style='padding:40px;'>

                        <h2>📥 Download Document</h2>

                        <a href='{fileUrl}' target='_blank' style='font-size:18px;'>
                            Open File
                        </a>

                    </div>";

                    break;

                default:

                    HtmlContent =
                        "<div class='system-message'>Unsupported file type.</div>";
                    break;
            }
        }
        catch
        {
            HtmlContent =
                "<div class='system-message'>Failed to load document.</div>";
        }
    }

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file is null)
            {
                return;
            }

            var extension =
                Path.GetExtension(file.Name);

            if (!SupportedExtensions.Contains(
                    extension,
                    StringComparer.OrdinalIgnoreCase))
            {
                HtmlContent =
                    "<div class='system-message'>Unsupported file type.</div>";

                return;
            }

            var fileName =
                Path.GetFileName(file.Name);

            if (string.IsNullOrWhiteSpace(fileName))
            {
                return;
            }

            var filesPath = Path.Combine(
                Environment.WebRootPath,
                "Files");

            var savePath = Path.Combine(
                filesPath,
                fileName);

            await using var stream =
                File.Create(savePath);

            await file.OpenReadStream(
                50 * 1024 * 1024)
                .CopyToAsync(stream);

            await LoadFiles();

            await LoadDocument(fileName);
        }
        catch
        {
            HtmlContent =
                "<div class='system-message'>File upload failed.</div>";
        }
    }

    private void ConfirmDelete(string file)
    {
        PendingDeleteFile = file;
    }

    private void CancelDelete()
    {
        PendingDeleteFile = null;
    }

    private async Task DeleteFile()
    {
        if (string.IsNullOrWhiteSpace(PendingDeleteFile))
        {
            return;
        }

        try
        {
            var filePath = Path.Combine(Environment.WebRootPath,"Files",PendingDeleteFile);

            if (File.Exists(filePath))
            {
                File.Delete(filePath);
            }

            PendingDeleteFile = null;

            await LoadFiles();
        }
        catch
        {
            HtmlContent ="<div class='system-message'>Failed to delete file.</div>";
        }
    }

    private string GetFileIcon(string file)
    {
        var extension =
            Path.GetExtension(file)
                .ToLowerInvariant();

        return extension switch
        {
            ".html" or ".htm" => "🌐 ",
            ".pdf" => "📕 ",
            ".png" or ".jpg" or ".jpeg" or ".webp" or ".gif" => "🖼️ ",
            ".mp4" or ".webm" => "🎥 ",
            ".txt" or ".json" => "📄 ",
            ".docx" => "📝 ",
            ".xlsx" or ".csv" => "📊 ",
            ".pptx" => "📽️ ",
            _ => "📁 "
        };
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

}
