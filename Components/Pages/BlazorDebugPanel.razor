@using Microsoft.AspNetCore.Components

<div style="position:fixed;bottom:10px;right:10px;
            background:#111;color:#fff;padding:12px;
            border-radius:8px;font-size:12px;z-index:9999;
            width:220px">

    <b>Blazor Debug</b>

    <div>Clicks: @clickCount</div>
    <div>Status: @(isInteractive ? "✅ Interactive" : "❌ NOT Interactive")</div>

    <button style="margin-top:8px;width:100%"
            @onclick="TestClick">
        Test Click
    </button>

</div>

@code {
    private int clickCount = 0;
    private bool isInteractive = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // If this runs → Blazor circuit is alive
            isInteractive = true;
            StateHasChanged();
        }
    }

    private void TestClick()
    {
        clickCount++;
        Console.WriteLine("DEBUG CLICK WORKING");
    }
}