@page "/system-doctor"
@layout MainLayout_NoRightPan
@attribute [Authorize(Roles = "Admin,SysAdmin")]

@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using MITANZ360Pro.Web.Services
@using MITANZ360Pro.Web.Services.SystemDoctor
@inject SharePointService SharePointService

<CascadingAuthenticationState>
    <div class="sd-page">
        <div class="sd-header">
            <div class="sd-title">
                <div class="sd-title-icon">@((MarkupString)Icons.HeartPulse)</div>
                <div>
                    <h2>System Doctor</h2>
                    <div class="sd-subtitle">Real-time application & platform health (runtime + Microsoft Graph)</div>
                </div>
            </div>

            <div class="sd-controls glass">
                <div class="sd-control-row">
                    <label class="sd-switch">
                        <input type="checkbox" @bind="autoRefresh" />
                        <span class="sd-slider"></span>
                    </label>
                    <span class="sd-control-label">Auto refresh</span>

                    <select class="sd-select" @bind="refreshSeconds">
                        <option value="2">2s</option>
                        <option value="3">3s</option>
                        <option value="5">5s</option>
                        <option value="10">10s</option>
                    </select>

                    <button class="sd-btn" @onclick="RunFullReport" disabled="@isBusy">
                        @((MarkupString)Icons.Stethoscope) Run Full Health Report
                    </button>

                    <button class="sd-btn sd-btn-secondary" @onclick="RunDeepChecks" disabled="@isBusy">
                        @((MarkupString)Icons.Radar) Deep Graph Checks
                    </button>
                </div>

                <div class="sd-control-row small">
                    <span class="sd-pill">Last update: <b>@(lastUpdateLocal)</b></span>
                    <span class="sd-pill">Report time: <b>@(lastReportMsText)</b></span>
                    <span class="sd-pill">History points: <b>@history.Count</b></span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="sd-alert glass sd-alert-danger">
                @((MarkupString)Icons.TriangleExclamation) @error
            </div>
        }

        <div class="sd-grid">
            <!-- LIVE METRICS -->
            <div class="glass sd-card">
                <div class="sd-card-title">
                    @((MarkupString)Icons.Activity) Live Runtime Metrics
                </div>

                <div class="sd-metric-grid">
                    @Metric("CPU", cpuPercentText, "cpu", Icons.Cpu)
                    @Metric("Working Set", $"{lastSnapshot?.WorkingSetMb:F0} MB", "mem", Icons.Memory)
                    @Metric("GC Heap", $"{lastSnapshot?.GcHeapMb:F0} MB", "gc", Icons.Database)
                    @Metric("Threads", $"{lastSnapshot?.ThreadCount}", "thr", Icons.Threads)
                    @Metric("Handles", lastSnapshot?.HandleCount >= 0 ? $"{lastSnapshot.HandleCount}" : "N/A", "hdl", Icons.Link)
                    @Metric("Uptime", uptimeText, "upt", Icons.Clock)
                </div>

                <div class="sd-charts">
                    <div class="sd-chart">
                        <div class="sd-chart-title">@((MarkupString)Icons.Cpu) CPU % (computed)</div>
                        @Sparkline(history.Select(h => h.CpuPercent).ToList(), 0, 100, "#7cffe1")
                    </div>

                    <div class="sd-chart">
                        <div class="sd-chart-title">@((MarkupString)Icons.Memory) Working Set (MB)</div>
                        @Sparkline(history.Select(h => h.WorkingSetMb).ToList(), 0, AutoMax(history.Select(h => h.WorkingSetMb)), "#8ab4ff")
                    </div>

                    <div class="sd-chart">
                        <div class="sd-chart-title">@((MarkupString)Icons.Database) GC Heap (MB)</div>
                        @Sparkline(history.Select(h => h.GcHeapMb).ToList(), 0, AutoMax(history.Select(h => h.GcHeapMb)), "#ffd37a")
                    </div>
                </div>
            </div>

            <!-- APP IDENTITY -->
            <div class="glass sd-card">
                <div class="sd-card-title">
                    @((MarkupString)Icons.Info) Application Identity
                </div>

                <div class="sd-kv">
                    @KV("App", lastSnapshot?.ApplicationName ?? "-")
                    @KV("Version", lastSnapshot?.Version ?? "-")
                    @KV("Environment", lastSnapshot?.EnvironmentName ?? "-")
                    @KV("Content Root", lastSnapshot?.ContentRootPath ?? "-")
                    @KV("Machine", lastSnapshot?.MachineName ?? "-")
                    @KV("OS", lastSnapshot?.OSDescription ?? "-")
                    @KV(".NET", lastSnapshot?.FrameworkDescription ?? "-")
                    @KV("Arch", lastSnapshot?.ProcessArchitecture ?? "-")
                </div>
            </div>

            <!-- HEALTH CHECKS -->
            <div class="glass sd-card sd-card-wide">
                <div class="sd-card-title">
                    @((MarkupString)Icons.Shield) Health Checks (Runtime + Microsoft Graph)
                </div>

                @if (lastReport is null)
                {
                    <div class="sd-muted">Run a report to see checks.</div>
                }
                else
                {
                    <div class="sd-checks">
                        @foreach (var c in lastReport.Checks)
                        {
                            <div class="sd-check glass2">
                                <div class="sd-check-top">
                                    <div class="sd-check-name">
                                        <span class="sd-check-icon">@((MarkupString)GetCategoryIcon(c.Category))</span>
                                        <span>@c.Category</span>
                                        <span class="sd-dot">•</span>
                                        <b>@c.Name</b>
                                    </div>
                                    <div class="sd-badge @BadgeClass(c.Status)">
                                        @c.Status
                                    </div>
                                </div>

                                <div class="sd-check-msg">@c.Message</div>

                                @if (!string.IsNullOrWhiteSpace(c.Recommendation))
                                {
                                    <div class="sd-check-rec">
                                        <span class="sd-rec-icon">@((MarkupString)Icons.Lightbulb)</span>
                                        @c.Recommendation
                                    </div>
                                }

                                <div class="sd-check-meta">
                                    <span>@c.CheckedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</span>
                                    @if (c.Value.HasValue)
                                    {
                                        <span class="sd-dot">•</span>
                                        <span>Value: <b>@c.Value.Value.ToString("0.##", CultureInfo.InvariantCulture) @c.Unit</b></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</CascadingAuthenticationState>

@code
{
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool autoRefresh = true;
    private int refreshSeconds = 3;

    private bool isBusy;
    private string? error;

    private SystemDoctorSnapshot? lastSnapshot;
    private SystemDoctorReport? lastReport;

    private string lastUpdateLocal = "-";
    private string lastReportMsText = "-";

    // Real CPU% computed between snapshots (no fake)
    private double lastCpuPercent;
    private string cpuPercentText => lastSnapshot is null ? "-" : $"{lastCpuPercent:0.0}%";
    private string uptimeText => lastSnapshot is null ? "-" : TimeSpan.FromSeconds(lastSnapshot.UptimeSeconds).ToString("g");

    // Historical series for charts (real-time)
    private readonly List<HistoryPoint> history = new();
    private PeriodicTimer? timer;
    private CancellationTokenSource? loopCts;

    private sealed class HistoryPoint
    {
        public DateTimeOffset AtUtc { get; set; }
        public double CpuPercent { get; set; }
        public double WorkingSetMb { get; set; }
        public double GcHeapMb { get; set; }
        public double TotalProcessorSeconds { get; set; }
        public double UptimeSeconds { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshSnapshotOnly(); // immediate real snapshot
        StartOrRestartLoop();
    }

    private void StartOrRestartLoop()
    {
        loopCts?.Cancel();
        loopCts?.Dispose();
        loopCts = new CancellationTokenSource();

        timer?.Dispose();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(refreshSeconds));

        _ = LoopAsync(loopCts.Token);
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                if (autoRefresh)
                    await RefreshSnapshotOnly();

                await timer!.WaitForNextTickAsync(ct);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshSnapshotOnly()
    {
        try
        {
            error = null;

            var user = await GetUserAsync();
            var snap = await SharePointService.GetSystemDoctorSnapshotAsync(user);

            ComputeCpuPercentAndUpdateHistory(snap);
            lastSnapshot = snap;

            lastUpdateLocal = DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm:ss");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ComputeCpuPercentAndUpdateHistory(SystemDoctorSnapshot snap)
    {
        // CPU% is computed from real TotalProcessorTime deltas between samples
        var now = snap.CapturedAtUtc;
        var tp = snap.TotalProcessorSeconds;

        if (history.Count > 0)
        {
            var prev = history[^1];
            var dt = (now - prev.AtUtc).TotalSeconds;
            var dCpu = tp - prev.TotalProcessorSeconds;

            if (dt > 0 && snap.ProcessorCount > 0)
            {
                var raw = (dCpu / (dt * snap.ProcessorCount)) * 100.0;
                lastCpuPercent = Math.Clamp(raw, 0, 100);
            }
        }

        history.Add(new HistoryPoint
        {
            AtUtc = now,
            CpuPercent = lastCpuPercent,
            WorkingSetMb = snap.WorkingSetMb,
            GcHeapMb = snap.GcHeapMb,
            TotalProcessorSeconds = tp,
            UptimeSeconds = snap.UptimeSeconds
        });

        // keep last 60 points
        if (history.Count > 60)
            history.RemoveRange(0, history.Count - 60);
    }

    private async Task RunFullReport()
    {
        isBusy = true;
        try
        {
            error = null;
            var user = await GetUserAsync();

            var report = await SharePointService.GetSystemDoctorReportAsync(
                user,
                deepGraphChecks: false);

            lastReport = report;
            lastReportMsText = $"{report.ElapsedMs} ms";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RunDeepChecks()
    {
        isBusy = true;
        try
        {
            error = null;
            var user = await GetUserAsync();

            var report = await SharePointService.GetSystemDoctorReportAsync(
                user,
                deepGraphChecks: true);

            lastReport = report;
            lastReportMsText = $"{report.ElapsedMs} ms";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> GetUserAsync()
    {
        if (AuthenticationStateTask is null)
            throw new InvalidOperationException("AuthenticationState is not available.");

        var state = await AuthenticationStateTask;
        return state.User;
    }

    protected override void OnParametersSet()
    {
        // If refresh interval changed, restart timer
        StartOrRestartLoop();
    }

    public void Dispose()
    {
        loopCts?.Cancel();
        loopCts?.Dispose();
        timer?.Dispose();
    }

    // ---------- UI helpers ----------

    private RenderFragment Metric(string title, string value, string key, string iconSvg) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-metric glass2");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-metric-icon");
        builder.AddMarkupContent(seq++, iconSvg);
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-metric-body");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-metric-title");
        builder.AddContent(seq++, title);
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-metric-value");
        builder.AddContent(seq++, value);
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment KV(string k, string v) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-kv-row");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-kv-k");
        builder.AddContent(seq++, k);
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "sd-kv-v");
        builder.AddContent(seq++, v);
        builder.CloseElement();
        builder.CloseElement();
    };

    private string BadgeClass(HealthStatus status) => status switch
    {
        HealthStatus.Critical => "sd-badge-critical",
        HealthStatus.Warning => "sd-badge-warning",
        _ => "sd-badge-healthy"
    };

    private static string GetCategoryIcon(string category) => category switch
    {
        "Graph" => Icons.Cloud,
        "Security" => Icons.Shield,
        "Runtime" => Icons.Activity,
        _ => Icons.Info
    };

    private static double AutoMax(IEnumerable<double> values)
    {
        var max = values.DefaultIfEmpty(1).Max();
        if (max <= 0) return 1;
        return max * 1.15;
    }

    private RenderFragment Sparkline(List<double> values, double min, double max, string stroke) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "svg");
        builder.AddAttribute(seq++, "class", "sd-spark");
        builder.AddAttribute(seq++, "viewBox", "0 0 200 60");
        builder.AddAttribute(seq++, "preserveAspectRatio", "none");

        // grid
        builder.OpenElement(seq++, "path");
        builder.AddAttribute(seq++, "d", "M0 50 H200");
        builder.AddAttribute(seq++, "class", "sd-spark-grid");
        builder.CloseElement();

        var pts = BuildPoints(values, min, max, 200, 60, 6);
        builder.OpenElement(seq++, "polyline");
        builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", stroke);
        builder.AddAttribute(seq++, "stroke-width", "2.5");
        builder.AddAttribute(seq++, "points", pts);
        builder.AddAttribute(seq++, "class", "sd-spark-line");
        builder.CloseElement();

        builder.CloseElement();
    };

    private static string BuildPoints(List<double> values, double min, double max, int width, int height, int pad)
    {
        if (values is null || values.Count == 0)
            return string.Empty;

        var w = width - pad * 2;
        var h = height - pad * 2;

        var denom = (max - min);
        if (denom <= 0) denom = 1;

        var step = values.Count == 1 ? 0 : (double)w / (values.Count - 1);

        return string.Join(" ",
            values.Select((v, i) =>
            {
                var x = pad + (step * i);
                var norm = (v - min) / denom;
                norm = Math.Clamp(norm, 0, 1);
                var y = pad + (h * (1 - norm));
                return $"{x:0.##},{y:0.##}";
            }));
    }

