        color: var(--ms-muted);
        line-height: 1.9;
        font-size: 1rem;
    }

    /* =========================
           TEXT RESPONSE
        ========================== */

    .text-viewer {
        background: rgba(255,255,255,0.62);
        border: 1px solid rgba(255,255,255,0.35);
        border-radius: 22px;
        padding: 28px;
    }

